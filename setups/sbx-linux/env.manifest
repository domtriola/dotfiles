# Environment files for the sbx-linux profile (a Docker Sandbox).
#
# Left out on purpose:
#   .claude/*     the sandbox runtime owns ~/.claude/settings.json, and the
#                 my-claude kit supplies the agent's settings and statusline.
#   .aws/config   a sandbox gets no credentials.
#   sbx-up, sbx-wait, sbx-pull
#                 a sandbox does not start sandboxes.
#   hammerspoon   macOS only.
#   tmux-sessionizer, troot
#                 host-side project navigation over ~/src.
#
# Directives (see ../../sync-env for the full reference):
#   group   <label>           print a heading
#   file    <src> <dest-dir>  copy one file into <dest-dir>
#   dir     <src> <dest>      replace <dest> with a copy of <src>
#   subdirs <src> <dest>      replace each immediate subdirectory of <src>
#
# <src> is relative to ./env/. <dest> must be $HOME or below it.

group Editor
dir .config/nvim $HOME/.config/nvim
# Used by nvim-lint:
file .markdownlint.json $HOME

group Shell configuration
file .zshrc $HOME
file .zprofile $HOME
file .bash_profile $HOME
file .bashrc $HOME
dir .bashrc.d $HOME/.bashrc.d

group Tmux configuration
file .tmux.conf $HOME
file .ready-tmux $HOME
file .local/bin/init-tmux $HOME/.local/bin
file .local/bin/ready-tmux $HOME/.local/bin

group Misc configs
file .gitconfig $HOME
