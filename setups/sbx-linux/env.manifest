# Environment files for the sbx-linux profile (a Docker Sandbox).
#
# Directive reference: ../../sync-env

group Editor
dir .config/nvim $HOME/.config/nvim
# Used by nvim-lint:
file .markdownlint.json $HOME

group Shell configuration
file .bash_profile $HOME
file .bashrc $HOME
dir .bashrc.d $HOME/.bashrc.d

group Tmux configuration
file .tmux.conf $HOME
file .ready-tmux $HOME
file .local/bin/init-tmux $HOME/.local/bin
file .local/bin/ready-tmux $HOME/.local/bin

group Misc configs
file .gitconfig $HOME

# Agent skills are deliberately absent. In a sandbox the agent-skills kit owns
# them, and it delivers them before the agent starts. This manifest runs from
# the dotfiles kit's startup hook, about twenty seconds later, and `dir` does
# an rm -rf before it copies: adding skills here would delete the skills
# directory out from under a running agent.
