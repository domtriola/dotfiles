#!/usr/bin/env bash
#
# The model server: llama.cpp behind llama-swap.
#
# llama-server runs one model per process. llama-swap sits in front of it,
# presents an OpenAI-compatible API on one port, and starts the right process
# when a request names a model. Together they do what Ollama would have done,
# without the wrapper overhead at short contexts.
#
# Both ship as prebuilt binaries, so nothing is compiled. The Vulkan build of
# llama.cpp is the one to take: it needs only a Mesa driver, it measured faster
# than ROCm on this GPU, and AMD publishes no ROCm packages for Ubuntu 26.04.
#
# Layout:
#   /opt/llama.cpp/<build>/        binaries and their shared libraries
#   /opt/llama.cpp/current         symlink to the build in use
#   /opt/llama-swap/<version>/     the llama-swap binary
#   /opt/llama-swap/current        symlink to the version in use
#   /var/lib/llama/models/*.gguf   models, put there by hand
#   /etc/llama-swap/config.yaml    generated from whatever models are present
#
# Models are not downloaded here. They are tens of gigabytes, and which ones to
# keep is an open question. Drop a .gguf into the models directory and run this
# again: the configuration is rebuilt from the directory every time.

set -eo pipefail

profile_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=lib/config.sh
source "$profile_dir/lib/config.sh"
ai_server_config_load

settings_file="/var/lib/llama/settings.json"
# shellcheck source=packages/ai-model/lib/registry
source "$profile_dir/packages/ai-model/lib/registry"

# Pinned, and overridable for a one-off upgrade. Raising these here is the
# supported way to move the whole machine to a new build.
llama_build="${LLAMA_CPP_BUILD:-b11057}"
swap_version="${LLAMA_SWAP_VERSION:-256}"

# The SHA-256 of each pinned archive, checked before anything is extracted.
#
# Take a new value from the release API when moving a pin, and read it rather
# than trusting the download:
#
#   curl -sL https://api.github.com/repos/ggml-org/llama.cpp/releases/tags/<tag> |
#     python3 -c 'import json,sys; [print(a["name"], a.get("digest"))
#                 for a in json.load(sys.stdin)["assets"]]'
#
# Set to "skip" to install an unpinned version without a digest, which is the
# only way $LLAMA_CPP_BUILD is useful for a one-off.
llama_sha256="${LLAMA_CPP_SHA256:-30de01e5e9a0f4ccb65afeaa2ed2961d7beee71aaaf63167b9cc2a04a70b4178}"
swap_sha256="${LLAMA_SWAP_SHA256:-557757336cde1a667f0b200d4a84c48c9f5fdf561fd8ae969a2bed9d8c94ec48}"

llama_root="/opt/llama.cpp"
swap_root="/opt/llama-swap"
models_dir="/var/lib/llama/models"
config_dir="/etc/llama-swap"
config="$config_dir/config.yaml"
unit="/etc/systemd/system/llama-swap.service"
service_user="llama"
listen="${LLAMA_SWAP_LISTEN:-0.0.0.0:${AI_SERVER_MODEL_PORT:-8080}}"

# ---------------------------------------------------------------------------
# Guard: refuse to install a GPU server that would run on the processor.
# ---------------------------------------------------------------------------
#
# Mesa answers with llvmpipe, a software renderer, when it cannot open the
# render node. It reports a device either way, so the driver name is what has
# to be read. Installing on top of that would produce a server that answers
# every request correctly and slowly, which is the hardest fault to notice.
if ! command -v vulkaninfo >/dev/null 2>&1; then
  echo "20_llama: vulkaninfo is missing. Run 10_packages first." >&2
  exit 1
fi

vk_driver="$(vulkaninfo --summary 2>/dev/null |
  awk -F'= ' '/driverName/ { gsub(/ /, "", $2); print $2; exit }')"

case "$vk_driver" in
radv)
  echo "Vulkan driver: radv"
  ;;
llvmpipe | "")
  cat >&2 <<EOF
20_llama: Vulkan reports "${vk_driver:-no device}", not radv.

llvmpipe is a software renderer. Installing now would give a model server that
answers correctly and runs on the processor.

Usually this is the render group. Check, then log out and back in:

  ls -l /dev/dri/renderD128
  id
EOF
  exit 1
  ;;
*)
  echo "20_llama: unexpected Vulkan driver '$vk_driver', continuing." >&2
  ;;
esac

# ---------------------------------------------------------------------------
# Service account
# ---------------------------------------------------------------------------
if id "$service_user" >/dev/null 2>&1; then
  echo "User $service_user already exists."
else
  echo "Creating system user $service_user."
  sudo useradd --system --home-dir /var/lib/llama --no-create-home \
    --shell /usr/sbin/nologin "$service_user"
fi

render_group="$(stat -c '%G' /dev/dri/renderD128 2>/dev/null || echo render)"
if ! id -nG "$service_user" | tr ' ' '\n' | grep -qx "$render_group"; then
  echo "Adding $service_user to $render_group."
  sudo usermod -aG "$render_group" "$service_user"
fi

# Created here rather than by `useradd --create-home`, which applies HOME_MODE
# from /etc/login.defs. That is 0700 or 0750 on Ubuntu, and a parent directory
# nobody can traverse makes everything below it invisible to every other
# account: `test -d` on the models directory then reports that it does not
# exist, which is true of nothing and misleading about everything.
#
# `install -d` sets the mode on a directory that already exists, so a home with
# the wrong mode is repaired rather than left.
sudo install -d -o "$service_user" -g "$service_user" -m 755 /var/lib/llama
sudo install -d -o "$service_user" -g "$service_user" -m 755 "$models_dir"
sudo install -d -m 755 "$config_dir"

# ---------------------------------------------------------------------------
# Binaries
# ---------------------------------------------------------------------------
#
# install_release downloads a tarball once and points <root>/current at it. The
# versioned directory is the idempotency check: a rerun with the same pin does
# nothing, and a changed pin installs beside the old one rather than over it,
# so going back is a symlink change.
install_release() {
  local root="$1" version="$2" url="$3" strip="$4" probe="$5" want="$6"
  local dest="$root/$version" tmp got

  if [[ -x "$dest/$probe" ]]; then
    echo "$root: $version is already installed."
  else
    echo "$root: installing $version"
    tmp="$(mktemp -d)"
    curl -fL --retry 3 --proto '=https' --tlsv1.2 -o "$tmp/release.tar.gz" "$url"

    # Checked before extraction, because extraction is what runs as root.
    if [[ "$want" == "skip" ]]; then
      echo "  WARNING: digest check skipped for $version" >&2
    else
      got="$(sha256sum "$tmp/release.tar.gz" | cut -d" " -f1)"
      if [[ "$got" != "$want" ]]; then
        rm -rf "$tmp"
        echo "20_llama: $version does not match its pinned digest." >&2
        echo "  expected $want" >&2
        echo "  got      $got" >&2
        echo "Nothing was extracted. Either the pin is stale or the file is not" >&2
        echo "what it was. Do not work around this by setting the digest to the" >&2
        echo "value that was downloaded without finding out why it changed." >&2
        exit 1
      fi
      echo "  digest ok"
    fi

    sudo install -d -m 755 "$dest"
    sudo tar xzf "$tmp/release.tar.gz" -C "$dest" --strip-components="$strip"
    rm -rf "$tmp"
  fi

  sudo ln -sfn "$version" "$root/current"
}

# The llama.cpp archive holds one directory, with the binaries and their shared
# libraries together in it. The binaries carry RUNPATH=$ORIGIN, so they find
# those libraries beside themselves and need no LD_LIBRARY_PATH.
install_release "$llama_root" "$llama_build" \
  "https://github.com/ggml-org/llama.cpp/releases/download/${llama_build}/llama-${llama_build}-bin-ubuntu-vulkan-x64.tar.gz" \
  1 llama-server "$llama_sha256"

# The llama-swap archive holds the binary at its root, beside its documentation.
install_release "$swap_root" "$swap_version" \
  "https://github.com/mostlygeek/llama-swap/releases/download/v${swap_version}/llama-swap_${swap_version}_linux_amd64.tar.gz" \
  0 llama-swap "$swap_sha256"

# Proof that the binary actually runs. A shared library it cannot find shows up
# here and nowhere earlier: the download succeeded, the files are in place, and
# every later step would report success while the server never starts.
if ! version_out="$("$llama_root/current/llama-server" --version 2>&1)"; then
  cat >&2 <<EOF
20_llama: llama-server is installed but will not run.

$version_out

A missing shared library is the usual cause. Check which, across the whole
directory, because the dependency is often on a library rather than on the
binary itself:

  ldd $llama_root/current/*.so $llama_root/current/llama-server 2>/dev/null |
    grep 'not found' | sort -u

If something is missing, run ./setup with no filter, so that 10_packages
installs the libraries first. If it is still missing after that, add it there.
EOF
  exit 1
fi
printf '%s\n' "$version_out" | head -2

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
#
# Rebuilt from the models directory on every run, so adding a model is a file
# copy followed by ./setup. Editing this file by hand does not last.
#
# ${PORT} is a llama-swap macro and has to reach the file literally, which is
# why the heredoc below is quoted and the model entries are appended after it.
tmp_config="$(mktemp)"
cat >"$tmp_config" <<'HEADER'
# Managed by dotfiles: setups/ai-server/20_llama
# Rebuilt on every run from the files in /var/lib/llama/models.

healthCheckTimeout: 600
logLevel: info
startPort: 10001

# Send the model's own output to stdout, and so to the journal.
#
# The default is "proxy", which keeps llama-swap's own lines and discards
# llama-server's. That loses the lines worth having: what the model loaded, how
# much memory the KV cache took, and why a load failed. They stay readable over
# HTTP at /logs/stream/upstream, but only in a buffer in memory, so a restart
# takes them with it and a machine that fell over has nothing to read.
#
# "both" costs a request-rate line per completion in the journal, which
# journald rotates and rate-limits on its own.
logToStdout: both

macros:
  # llama-server binds loopback only. llama-swap is the process that faces the
  # network, and 25_network is what limits it to the overlay.
  #
  # -ngl all offloads every layer. This machine has about 124 GiB of unified
  # memory, so a partial offload would be a fault rather than a compromise.
  #
  # --jinja selects the model's own chat template, which is what makes tool
  # calling work. A coding agent is unusable without it.
  #
  # Flash attention is required before the KV cache can be quantised, and the
  # quantisation itself is set per model, below.
  "server": >
    /opt/llama.cpp/current/llama-server
    --host 127.0.0.1
    --port ${PORT}
    -ngl all
    --flash-attn on
    --jinja

models:
HEADER

model_count=0
while IFS= read -r gguf; do
  base="$(basename "$gguf" .gguf)"

  # A split model is several files that the loader treats as one: given any
  # shard it finds the rest in the same directory. So only the first shard
  # gets an entry, named for the prefix rather than the shard. Without this a
  # five-part model would produce five entries, four of them broken.
  if [[ "$base" =~ ^(.*)-([0-9]{5})-of-([0-9]{5})$ ]]; then
    [[ "${BASH_REMATCH[2]}" == "00001" ]] || continue
    name="${BASH_REMATCH[1]}"
  else
    name="$base"
  fi

  model_count=$((model_count + 1))

  # Shards are summed, because the loader reads all of them and the whole set
  # is what sits in memory. A model that is not split is just its own file.
  #
  # The two cases are separated rather than handled by one glob. Stripping the
  # shard suffix from a name that has none leaves the name unchanged, ".gguf"
  # and all, so the glob became "...gguf*.gguf", matched nothing, and the
  # arithmetic on an empty string ended the script before the configuration
  # was written.
  if [[ "$gguf" == *-00001-of-* ]]; then
    size_bytes="$(du -cb "${gguf%-00001-of-*}"-[0-9][0-9][0-9][0-9][0-9]-of-*.gguf 2>/dev/null |
      tail -1 | cut -f1)"
  else
    size_bytes="$(stat -c %s "$gguf" 2>/dev/null)"
  fi

  # A size that cannot be read is not worth ending the run for.
  [[ "$size_bytes" =~ ^[0-9]+$ ]] || size_bytes=0
  size_gb=$((size_bytes / 1000000000))

  # A model with no entry gets one, so that a file copied into the directory by
  # hand is served on the same terms as one that was downloaded.
  registry_ensure "$name" "${AI_SERVER_DEFAULT_CTX:-131072}"
  ctx="$(registry_get "$name" ctx "${AI_SERVER_DEFAULT_CTX:-131072}")"
  cache="$(registry_get "$name" cache_type q8_0)"
  trained="$(registry_get "$name" trained_ctx 0)"

  echo "  $name: ${size_gb} GB, context $ctx, cache $cache"

  # The context is published in the model's metadata as well as passed to the
  # engine. A client that reads /v1/models can then ration itself to what this
  # machine actually serves, rather than to its own default.
  cat >>"$tmp_config" <<EOF
  "$name":
    # ttl 0 keeps the model loaded. Nothing else competes for this machine.
    ttl: 0
    metadata:
      context_length: $ctx
      trained_context: $trained
    cmd: |
      \${server}
      --model $gguf
      --ctx-size $ctx
      --cache-type-k $cache
      --cache-type-v $cache
      --alias $name
EOF
done < <(find "$models_dir" -maxdepth 1 -type f -name '*.gguf' | sort)

if [[ $model_count -eq 0 ]]; then
  # `models` is a required key, so it is written empty rather than omitted.
  echo "  {}" >>"$tmp_config"
fi

if [[ -f "$config" ]] && sudo cmp -s "$tmp_config" "$config"; then
  echo "$config is already correct ($model_count model(s))."
  config_changed=0
else
  echo "Writing $config ($model_count model(s))."
  sudo install -m 644 "$tmp_config" "$config"
  config_changed=1
fi
rm -f "$tmp_config"

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
#
# SupplementaryGroups is how the service reaches the GPU. A unit does not read
# the group file the way a login shell does, so adding the user to the render
# group is not by itself enough.
tmp_unit="$(mktemp)"
cat >"$tmp_unit" <<EOF
# Managed by dotfiles: setups/ai-server/20_llama
[Unit]
Description=llama-swap model server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$service_user
Group=$service_user
SupplementaryGroups=$render_group
# Every address, because the overlay interface does not exist on a first run.
# 25_network narrows it with a drop-in once there is an address to narrow to.
#
# The variable reaches llama-swap through --listen below and not on its own:
# LLAMA_SWAP_* variables work in the project's Docker images, and this binary
# reads only the flag, defaulting to every address without it.
Environment=LLAMA_SWAP_LISTEN=$listen
ExecStart=$swap_root/current/llama-swap --config $config --listen \${LLAMA_SWAP_LISTEN}
Restart=always
RestartSec=3

# This process parses model files and answers HTTP. It needs its models, its
# configuration, a socket and the GPU, and nothing else. These limit what a
# fault in it can reach.
#
# Deliberately absent, because each would break this particular service:
#   PrivateDevices           removes /dev/dri, so the GPU disappears
#   MemoryDenyWriteExecute   Vulkan compiles shaders at run time
#   RestrictAddressFamilies  device enumeration uses netlink
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/lib/llama

[Install]
WantedBy=multi-user.target
EOF

if [[ -f "$unit" ]] && sudo cmp -s "$tmp_unit" "$unit"; then
  echo "$unit is already correct."
  unit_changed=0
else
  echo "Writing $unit"
  sudo install -m 644 "$tmp_unit" "$unit"
  unit_changed=1
fi
rm -f "$tmp_unit"

if [[ $unit_changed -eq 1 ]]; then
  sudo systemctl daemon-reload
fi

sudo systemctl enable llama-swap >/dev/null

if [[ $model_count -eq 0 ]]; then
  cat <<EOF

No models are installed, so llama-swap is enabled but not started.

Download one, then run this again:

  ai-model add <repo> '<pattern>'
  ai-model add unsloth/Qwen3.8-Flash-Next-GGUF '*UD-Q4_K_XL*'

Run "ai-model --help" for the rest. A file copied into $models_dir by
hand works too, as long as the $service_user user can read it.
EOF
  exit 0
fi

if [[ $config_changed -eq 1 || $unit_changed -eq 1 ]]; then
  sudo systemctl restart llama-swap
else
  sudo systemctl start llama-swap
fi

# The merged value, not the one written above: a drop-in can move the listener
# onto the overlay, and loopback stops answering when it does.
effective="$(systemctl show -p Environment --value llama-swap 2>/dev/null |
  tr ' ' '\n' | sed -n 's/^LLAMA_SWAP_LISTEN=//p' | tail -1)"
effective="${effective:-$listen}"

probe_host="${effective%:*}"
# 0.0.0.0 means every address, which is not an address to connect to.
[[ -z "$probe_host" || "$probe_host" == "0.0.0.0" ]] && probe_host="127.0.0.1"

echo
echo "llama-swap is listening on $effective. Models:"
# Checked in two steps. Piping a failed request straight into python printed a
# JSON traceback over the top of the real problem.
if served="$(curl -fsS --max-time 10 "http://${probe_host}:${effective##*:}/v1/models" 2>/dev/null)"; then
  printf '%s' "$served" |
    python3 -c 'import json,sys; [print("  " + m["id"]) for m in json.load(sys.stdin)["data"]]' 2>/dev/null ||
    echo "  (answered, but the reply was not a model list)"
else
  echo "  (no answer yet, check: journalctl -u llama-swap -n 50)"
fi
