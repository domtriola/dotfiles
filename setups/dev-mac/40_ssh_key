#!/usr/bin/env bash
#
# Creates an SSH key in the Secure Enclave, and signs Git commits with it.
#
# The private key never leaves the Secure Enclave, and every use needs Touch
# ID. macOS supplies the provider (/usr/lib/ssh-keychain.dylib), so no agent
# socket is used.
#
# The key file in ~/.ssh is a reference to the key, not the private key. It is
# named id_ecdsa_sk, which ssh tries by default, so ~/.ssh/config needs no
# IdentityFile.
#
# Needs Touch ID, so this script cannot run unattended the first time.

set -eox pipefail

key_label="ssh"
key_file="$HOME/.ssh/id_ecdsa_sk"
allowed_signers="$HOME/.ssh/allowed_signers"
provider="/usr/lib/ssh-keychain.dylib"

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

# Key
# #######################################################

# OpenSSH supports p-256-ne only. It does not support p-384-ne.
if ! sc_auth list-ctk-identities -t ssh | grep -q "$key_label"; then
  echo "NOTE: Use Touch ID if asked. This creates the key in the Secure Enclave."
  sc_auth create-ctk-identity -l "$key_label" -k p-256-ne -t bio
fi

# ssh-keygen -K writes every resident key to the current directory. Newer
# macOS names each file after its label (id_ecdsa_sk_rk_ssh). Older macOS
# writes every key to id_ecdsa_sk_rk, and each key overwrites the previous
# one. A temporary directory keeps that output out of ~/.ssh until the result
# is known.
if [[ ! -f "$key_file" ]]; then
  echo "NOTE: Use Touch ID. Then, at \"Enter PIN for authenticator\", press Enter."
  echo "      The key has no PIN. ssh-keygen asks for one because it treats the"
  echo "      Secure Enclave as a FIDO security key."
  tmp_dir="$(mktemp -d)"
  (cd "$tmp_dir" && /usr/bin/ssh-keygen -w "$provider" -K -N "")
  downloaded="$tmp_dir/id_ecdsa_sk_rk_$key_label"
  [[ -f "$downloaded" ]] || downloaded="$tmp_dir/id_ecdsa_sk_rk"
  if [[ ! -f "$downloaded" ]]; then
    echo "ssh-keygen did not write the \"$key_label\" key. It wrote:" >&2
    ls "$tmp_dir" >&2
    exit 1
  fi
  mv "$downloaded" "$key_file"
  mv "$downloaded.pub" "$key_file.pub"
  rm -rf "$tmp_dir"
  chmod 600 "$key_file"
fi

# Git commit signing
# #######################################################

git config --global gpg.format ssh
git config --global user.signingkey "$key_file"
git config --global gpg.ssh.program "$HOME/.local/bin/ssh-keygen-enclave"
git config --global commit.gpgsign true

# For `git log --show-signature`. Verification needs only the public key.
email="$(git config --global user.email || true)"
if [[ -z "$email" ]]; then
  echo "Set user.email with git config --global, then run this script again." >&2
  exit 1
fi
echo "$email $(cat "$key_file.pub")" >"$allowed_signers"
git config --global gpg.ssh.allowedSignersFile "$allowed_signers"
