#!/usr/bin/env bash
#
# Third party packages
#
# Trust a tap only if it is owned by the vendor of the software it ships.

set -eox pipefail

profile_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=lib/brew.sh
source "$profile_dir/lib/brew.sh"

# CLI tools
# #######################################################

brew_install jq
brew_install fzf
brew_install tree
brew_install autojump
brew_install ripgrep
brew_install wget
brew_install cheat

# For API requests
brew_install httpie

# Example usage: `magick ./image.heic ./image.jpeg`
brew_install imagemagick

# Postgres client tools: psql, pg_dump, pg_restore, pgbench.
#
# Keg-only, because it conflicts with the postgresql formula, so the link is
# what puts psql on PATH.
brew_install libpq
brew link --force --overwrite libpq

# Development Environment
# #######################################################

brew_install neovim
brew_install --cask ghostty
brew_install tmux

# AI
# #######################################################

brew_install --cask claude-code

# Sandboxing
brew_trust docker/tap
brew_install docker/tap/sbx

# Desktop Management
# #######################################################

# For automating macOS with Lua scripts
brew_install --cask hammerspoon

# Network Management
# #######################################################

# Installs a root daemon and a VPN interface.
brew_trust netbirdio/tap
brew_install netbirdio/tap/netbird
brew_install --cask netbirdio/tap/netbird-ui

# Security
# #######################################################

# Terminal command security
brew_trust sheeki03/tap
brew_install sheeki03/tap/tirith
