#!/usr/bin/env bash
# A fake Secret Service, with one secret in $FAKE_STATE/store. It logs each
# call, so that a test can check that a command did not use it.
printf '%s\n' "$*" >>"$FAKE_STATE/secret-tool.argv"
case "$1" in
store) cat >"$FAKE_STATE/store" ;;
lookup) [[ -f "$FAKE_STATE/store" ]] && cat "$FAKE_STATE/store" ;;
*) exit 2 ;;
esac
