#!/usr/bin/env bash
#
# A fake sbx. It logs each call to $FAKE_STATE/sbx.log, keeps the secrets
# that `secret set` stores under $FAKE_STATE/secrets, and runs a --command
# once, as sbx does when it stores one.

printf '%s\n' "$*" >>"$FAKE_STATE/sbx.log"

case "$1 ${2:-}" in
"secret set")
  shift 2
  sandbox="" command=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --sandbox) sandbox="$2"; shift ;;
    --command) command="$2"; shift ;;
    esac
    shift
  done
  if [[ -n "$command" ]] && ! (cd "$(mktemp -d)" && sh -c "$command" >/dev/null); then
    echo "sbx: the command failed" >&2
    exit 1
  fi
  mkdir -p "$FAKE_STATE/secrets"
  printf '%s' "$command" >"$FAKE_STATE/secrets/${sandbox:-global}"
  ;;
"secret ls")
  echo "${FAKE_SBX_SECRETS:-[]}"
  ;;
"policy approval")
  # The table that `sbx policy approval ls` prints: a header, then one row per
  # pending approval, from FAKE_SBX_APPROVALS ("<id> <sandbox> <title>" lines).
  case "$3" in
  ls)
    # Each column is as wide as its longest value, as in the real table.
    rows=("APPROVAL"$'\t'"SANDBOX"$'\t'"TITLE"$'\t'"DETAIL"$'\t'"OPTIONS")
    while read -r id sandbox title; do
      [[ -n "$id" ]] || continue
      rows+=("$id"$'\t'"$sandbox"$'\t'"$title"$'\t'"Protocol: TCP Resource type: domain"$'\t'"allow (Allow), dismiss (Dismiss)")
    done <<<"${FAKE_SBX_APPROVALS:-}"
    widths=(0 0 0 0)
    for row in "${rows[@]}"; do
      IFS=$'\t' read -r -a cells <<<"$row"
      for i in 0 1 2 3; do
        ((${#cells[i]} > widths[i])) && widths[i]=${#cells[i]}
      done
    done
    for row in "${rows[@]}"; do
      IFS=$'\t' read -r -a cells <<<"$row"
      printf '%-*s   %-*s   %-*s   %-*s   %s\n' "${widths[0]}" "${cells[0]}" "${widths[1]}" "${cells[1]}" \
        "${widths[2]}" "${cells[2]}" "${widths[3]}" "${cells[3]}" "${cells[4]}"
    done
    ;;
  respond) echo "Recorded: ${*: -1}" ;;
  esac
  ;;
"ls --quiet")
  printf '%s\n' ${FAKE_SBX_SANDBOXES:-}
  ;;
"exec "*)
  # sbx-wait's probes, answered from FAKE_SBX_* variables. Anything else, such
  # as the login shell, succeeds at once.
  script="${*: -1}"
  [[ -z "${FAKE_SBX_DOWN:-}" ]] || exit 1
  case "$script" in
  *"test -f"*".dotfiles-kit.status"*) [[ -n "${FAKE_SBX_KIT_STATUS:-}" ]] ;;
  *"cat"*".dotfiles-kit.status"*) echo "$FAKE_SBX_KIT_STATUS" ;;
  *"tail"*".dotfiles-kit.log"*) echo "the kit log" ;;
  esac
  ;;
"rm "*)
  [[ -z "${FAKE_SBX_RM_ERROR:-}" ]] || { echo "$FAKE_SBX_RM_ERROR" >&2; exit 1; }
  ;;
esac
