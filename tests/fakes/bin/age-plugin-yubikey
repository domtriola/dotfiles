#!/usr/bin/env bash
# A fake age-plugin-yubikey, for the YubiKey that --serial names. A key has an
# age slot once --generate made one, which is recorded as
# $FAKE_STATE/yubikey-<serial>.
printf '%s\n' "$*" >>"$FAKE_STATE/age-plugin-yubikey.argv"
key=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  [[ "${args[$i]}" == "--serial" ]] && key="${args[$((i + 1))]}"
done
[[ -n "$key" ]] || exit 2
upper="$(printf '%s' "$key" | tr '[:lower:]' '[:upper:]')"

slot() {
  printf '#       Serial: %s, Slot: 1\n' "$key"
  printf '#   PIN policy: Once\n'
  printf '#    Recipient: age1yubikey1%s\n' "$key"
  printf 'AGE-PLUGIN-YUBIKEY-1%s\n' "$upper"
}

case "$1" in
--identity) [[ ! -f "$FAKE_STATE/yubikey-$key" ]] || slot ;;
--generate)
  touch "$FAKE_STATE/yubikey-$key"
  slot
  ;;
*) exit 2 ;;
esac
