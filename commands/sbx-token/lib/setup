#!/usr/bin/env bash
#
# Getting an App onto this machine: registering a new one, or importing a key
# of one that another machine registered.

# GitHub sends the browser here after the App is created. Nothing listens on
# this port, so the code in the address stays on this machine: anyone who has
# the code can exchange it for the App's private key within the hour.
setup_redirect="http://127.0.0.1:1/sbx-token"

# setup <account> <name> registers a new App with the manifest flow, stores
# its private key, and opens the page that installs it.
setup() {
  local account="$1" name="$2" state manifest dir page url code status=0 out id slug pem

  if [[ -f "$sbx_token_config" ]]; then
    config_load
    die "this machine already uses the $app_slug App. To use another, remove $sbx_token_config first."
  fi

  state="$(openssl rand -hex 16)"
  manifest="$(jq -nc \
    --arg name "$name" \
    --arg url "https://github.com/$account" \
    --arg redirect "$setup_redirect" \
    --argjson perms "$scope_ceiling" '{
      name: $name,
      url: $url,
      description: "Mints short-lived tokens for Docker sandboxes (sbx-token).",
      public: false,
      hook_attributes: {url: $url, active: false},
      redirect_url: $redirect,
      default_permissions: $perms
    }')"

  # GitHub takes the manifest only as a form POST, so a local page sends it.
  dir="$(mktemp -d)"
  page="$dir/create-app.html"
  cat >"$page" <<HTML
<!doctype html>
<form id="f" method="post" action="https://github.com/settings/apps/new?state=$state">
<input type="hidden" name="manifest" value="$(jq -rn --arg m "$manifest" '$m | @html')">
<noscript><button type="submit">Create the App on GitHub</button></noscript>
</form>
<script>document.getElementById("f").submit()</script>
HTML

  cat >&2 <<MSG
1. A browser page opens and sends you to GitHub. If it does not open, open:
   $page
2. Check the name, and click "Create GitHub App".
3. The browser then shows "unable to connect". That is expected. Copy the
   whole address from the address bar, and paste it here.

MSG
  open_in_browser "$page"

  printf 'Address: ' >&2
  IFS= read -r url || die "no address was given"
  rm -rf "$dir"

  [[ "$url" =~ [?\&]code=([A-Za-z0-9]+) ]] || die "the address holds no code"
  code="${BASH_REMATCH[1]}"
  [[ "$url" =~ [?\&]state=([A-Za-z0-9]+) && "${BASH_REMATCH[1]}" == "$state" ]] ||
    die "the address is not from this setup (its state does not match)"

  out="$(api POST "/app-manifests/$code/conversions" "")" || status=$?
  [[ "$status" -eq 0 ]] || api_die "could not get the new App from GitHub" "$status" "$out"

  id="$(jq -r '.id' <<<"$out")"
  slug="$(jq -r '.slug' <<<"$out")"
  pem="$(jq -r '.pem' <<<"$out")"
  [[ "$id" =~ ^[0-9]+$ && -n "$slug" && "$pem" == "-----BEGIN"* ]] ||
    die "GitHub sent back an App without an ID, a slug or a key"

  printf '%s\n' "$pem" | store_put
  config_save "$id" "$slug"

  cat >&2 <<MSG

The $slug App is registered, and its key is in the $(store_backend) store.

Last step: install it. On the page that opens, choose your account, choose
"All repositories", and click "Install". If it does not open, open:
   $(install_url "$slug")

Then run: sbx-token check
MSG
  open_in_browser "$(install_url "$slug")"
}

# import_key <app id> <pem file> gives this machine its own key for an App
# that already exists.
import_key() {
  local id="$1" file="$2" jwt out status=0 slug

  [[ "$id" =~ ^[0-9]+$ ]] || die "not an App ID: $id"
  [[ -f "$file" ]] || die "no such file: $file"
  openssl pkey -in "$file" -noout 2>/dev/null || die "$file is not a private key"

  store_put <"$file"

  # The slug is read from GitHub rather than asked for, which also proves
  # that the key belongs to the App.
  app_id="$id"
  jwt="$(app_jwt)" || exit 1
  out="$(api GET "/app" "$jwt")" || status=$?
  [[ "$status" -eq 0 ]] || api_die "the key does not authenticate as App $id" "$status" "$out"
  slug="$(jq -r '.slug' <<<"$out")"
  config_save "$id" "$slug"

  printf 'sbx-token: this machine now uses the %s App. Delete %s.\n' "$slug" "$file" >&2
}

open_in_browser() {
  local opener
  if [[ "$(uname -s)" == "Darwin" ]]; then opener="open"; else opener="xdg-open"; fi
  if command -v "$opener" >/dev/null 2>&1; then
    "$opener" "$1" >/dev/null 2>&1 || true
  fi
}
