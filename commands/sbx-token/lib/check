#!/usr/bin/env bash
#
# Whether this machine can mint tokens, for doctor and for a person.

# check [offline] prints one line and exits 0 when the App authenticates, 3
# when this machine has no App set up yet, and 1 for anything else. Offline,
# it only checks that the config and the key are on this machine.
check() {
  local offline="${1:-false}" jwt out status=0 installs

  if [[ ! -f "$sbx_token_config" ]]; then
    printf 'not set up, run sbx-token setup or sbx-token import-key\n'
    exit 3
  fi
  config_load
  if [[ "$offline" == "true" ]]; then
    store_get >/dev/null || exit 1
    printf '%s, key stored (not checked with GitHub)\n' "$app_slug"
    return
  fi
  jwt="$(app_jwt)" || exit 1

  out="$(api GET "/app/installations" "$jwt")" || status=$?
  [[ "$status" -eq 0 ]] || api_die "the $app_slug App could not authenticate" "$status" "$out"

  installs="$(jq -r 'map(.account.login) | join(", ")' <<<"$out")"
  if [[ -z "$installs" ]]; then
    printf '%s is not installed on any account, install it at %s\n' "$app_slug" "$(install_url "$app_slug")"
    exit 1
  fi
  printf '%s, installed on %s\n' "$app_slug" "$installs"
}
