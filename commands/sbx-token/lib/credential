#!/usr/bin/env bash
#
# A git credential helper, so that the machine itself can clone and fetch the
# repositories that the App is installed on.
#
# git runs `sbx-token credential <action>` and writes the request on stdin, one
# key=value per line. With credential.useHttpPath, the request names the
# repository in "path". Only "get" answers. "store" and "erase" do nothing,
# because every token is new and expires after one hour.

# The permissions of a credential token: read the code, and nothing more. The
# machine's own clones never push (agent-server-I14).
credential_perms=(contents=read pull_requests=none issues=none actions=none)

# credential <action> reads git's request, and for "get" on github.com prints
# a username and a token for the one repository in the path. For another
# host it prints nothing, so that git asks its next helper.
credential() {
  local action="$1" line protocol="" host="" path="" token

  while IFS= read -r line && [[ -n "$line" ]]; do
    case "$line" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*) host="${line#host=}" ;;
    path=*) path="${line#path=}" ;;
    esac
  done

  [[ "$action" == "get" ]] || return 0
  [[ "$protocol" == "https" && "$host" == "github.com" ]] || return 0

  [[ -n "$path" ]] ||
    die "git gave no repository path. Run: git config --global credential.https://github.com.useHttpPath true"
  path="${path%/}"
  path="${path%.git}"

  # mint_token reads repos and perms, as the entry point sets them for mint.
  # shellcheck disable=SC2034
  repos=("$path")
  # shellcheck disable=SC2034
  perms=("${credential_perms[@]}")
  token="$(mint_token)" || exit 1
  printf 'username=x-access-token\npassword=%s\n' "$token"
}
