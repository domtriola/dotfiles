#!/usr/bin/env bash
#
# Usage: doctor [--profile <name>] [--offline]
#
# Reports whether this machine is configured the way its profile intends.
# Changes nothing.
#
# Every profile gets the dotfiles check: a warning for each manifest target
# with drift (see sync-env --help). The other checks for a profile live in
# profiles/<profile>/lib/doctor.sh, which this script sources. Anything under lib/ is invisible to setup, which only
# looks at files directly inside the profile directory.
#
# Some checks read configuration that only root can see, so sudo may prompt
# once.
#
# Arguments:
#   --profile  The use-case of this machine. Only needed when the profile has
#              not been saved yet. $DOTFILES_PROFILE overrides it.
#   --offline  Skip the checks that ask an upstream service: what the newest
#              release is, and whether the sandbox token App authenticates
#              with GitHub. Everything else reads local state only.
#
# Exit status:
#   0  nothing failed
#   1  at least one check failed
#
# There is no `set -e`. A check that reports a problem usually does so by
# running a command that exits non-zero, and that is a result rather than an
# error.

set -o pipefail

# Lookup order: commands/README.md, "Finding the checkout".
dotfiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)"
[[ -d "$dotfiles_dir/profiles" ]] ||
  dotfiles_dir="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/checkout" 2>/dev/null || true)"
dotfiles_dir="${DOTFILES_DIR:-$dotfiles_dir}"
if [[ ! -d "$dotfiles_dir/profiles" ]]; then
  echo "doctor: no dotfiles checkout found. Run sync-env from one, or set \$DOTFILES_DIR." >&2
  exit 1
fi
source "$dotfiles_dir/lib/platform.sh"
source "$dotfiles_dir/lib/profile.sh"
source "$dotfiles_dir/lib/manifest.sh"
source "$dotfiles_dir/lib/drift.sh"
source "$dotfiles_dir/lib/style.sh"

profile_arg=""
doctor_offline="0"
while [[ $# -gt 0 ]]; do
  case "$1" in
  --offline)
    doctor_offline="1"
    ;;
  --profile)
    shift
    profile_arg="${1:-}"
    if [[ -z "$profile_arg" ]]; then
      echo "doctor: --profile needs a name (one of: $(profile_list))" >&2
      exit 1
    fi
    ;;
  --profile=*) profile_arg="${1#--profile=}" ;;
  -h | --help)
    awk 'NR > 2 && !/^#/ { exit } NR > 2 { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
    exit 0
    ;;
  *)
    echo "doctor: unknown argument '$1'" >&2
    exit 1
    ;;
  esac
  shift
done

# "1" for a dry run, so resolving the profile never saves it. Reporting on a
# machine should not change what the machine is.
profile="$(resolve_profile "$profile_arg" "1")" || exit 1

# ---------------------------------------------------
# Reporting
# ---------------------------------------------------

count_ok=0
count_warn=0
count_fail=0
count_pending=0
count_tunable=0

# ok       the machine matches what the profile intends
# warn     working, but not what was intended, and worth a look
# fail     broken, or a setting that silently does nothing
# pending  not configured yet, and not expected to be
# tunable  a choice, currently set this way, that can be changed at any time
ok() {
  count_ok=$((count_ok + 1))
  status ok "$@"
}
warn() {
  count_warn=$((count_warn + 1))
  status warn "$@"
}
fail() {
  count_fail=$((count_fail + 1))
  status FAIL "$@"
}
pending() {
  count_pending=$((count_pending + 1))
  status pending "$@"
}

# A tunable is not a result, so it counts towards nothing and never decides the
# exit status. It is listed so that a setting is visible as a choice rather
# than found later in a file.
tunable() {
  count_tunable=$((count_tunable + 1))
  status tunable "$@"
}

# have reports whether a command exists, for checks that depend on one.
have() { command -v "$1" >/dev/null 2>&1; }

# latest_release_tag prints the newest release tag of a GitHub repository, or
# nothing when it cannot be read.
#
# The /releases/latest endpoint is deliberately not used. It reports whichever
# release upstream marked as latest, which for llama.cpp is not its newest
# build tag, so it would report a machine as out of date against the wrong
# number.
latest_release_tag() {
  curl -fsSL --max-time "${doctor_net_timeout:-6}" \
    "https://api.github.com/repos/$1/releases?per_page=1" 2>/dev/null |
    sed -nE 's/.*"tag_name": *"([^"]*)".*/\1/p' | head -1
}

# check_release compares an installed version against the newest release and
# says how far behind it is. Versions here are a prefix and an integer that
# only ever increases, so the difference is a count of releases.
#
# Usage: check_release <label> <owner/repo> <installed> <prefix>
check_release() {
  local label="$1" repo="$2" installed="$3" prefix="$4" latest delta

  if [[ "$doctor_offline" == "1" ]]; then
    pending "$label" "update check skipped"
    return
  fi

  latest="$(latest_release_tag "$repo")"
  if [[ -z "$latest" ]]; then
    warn "$label" "could not reach github.com to compare"
    return
  fi

  if [[ -z "$installed" ]]; then
    pending "$label" "not installed, newest is $latest"
    return
  fi

  # The prefix is stripped from both sides before anything is compared. An
  # installed version and its upstream tag do not always spell it the same way:
  # llama-swap installs as "256" and tags the release "v256".
  local a="${installed#"$prefix"}" b="${latest#"$prefix"}"

  if [[ "$a" == "$b" ]]; then
    ok "$label" "$installed is current"
    return
  fi

  if [[ "$a" =~ ^[0-9]+$ && "$b" =~ ^[0-9]+$ ]]; then
    delta=$((b - a))
    if [[ $delta -le 0 ]]; then
      ok "$label" "$installed is newer than the published $latest"
    else
      warn "$label" "$installed installed, $latest available ($delta behind)"
    fi
  else
    warn "$label" "$installed installed, $latest available"
  fi
}

# ---------------------------------------------------
# Check the dotfiles
# ---------------------------------------------------

profile_dir="$dotfiles_dir/profiles/$profile"

heading "doctor: $profile"

# check_drift warns once for each target with drift. It says nothing when
# there is no drift, and before the first sync writes a record.
check_drift() {
  local action directive rest src dest drift header="0"

  [[ -f "$SYNC_RECORD" ]] || return 0
  if ! read_manifest "$profile_dir/env.manifest" 2>/dev/null; then
    section "Dotfiles"
    warn "manifest" "cannot be read, see sync-env --dry"
    return
  fi

  for action in "${actions[@]}"; do
    directive="${action%%|*}"
    rest="${action#*|}"
    src="${rest%%|*}"
    dest="${rest#*|}"
    [[ "$directive" == "group" ]] && continue

    drift="$(target_drift "$directive" "$src" "$dest")"
    [[ -n "$drift" ]] || continue

    if [[ "$header" == "0" ]]; then
      section "Dotfiles"
      header="1"
    fi
    warn "$(tilde "$dest")" "$(grep -c . <<<"$drift") file(s) drifted, see sync-env --dry"
  done
}
check_drift

# ---------------------------------------------------
# Run the profile's checks
# ---------------------------------------------------

checks="$profile_dir/lib/doctor.sh"

if [[ -f "$checks" ]]; then
  # shellcheck source=/dev/null
  source "$checks"
else
  section "Checks"
  status info "$profile" "no checks are written, add them at profiles/$profile/lib/doctor.sh"
fi

# ---------------------------------------------------
# Summary
# ---------------------------------------------------

summary="doctor: $count_ok ok, $count_warn warn, $count_fail FAIL, $count_pending pending"
# Only when there are any. A profile with no settings to change should not
# have a count of settings.
if [[ $count_tunable -gt 0 ]]; then
  summary+=", $count_tunable tunable"
fi

if [[ $count_fail -gt 0 ]]; then
  worst="FAIL"
elif [[ $count_warn -gt 0 ]]; then
  worst="warn"
else
  worst="ok"
fi

echo
verdict "$worst" "$summary"

if [[ $count_fail -gt 0 ]]; then
  exit 1
fi
exit 0
