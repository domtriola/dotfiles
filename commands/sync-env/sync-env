#!/usr/bin/env bash
#
# Usage: sync-env [--profile <name>] [--dry]
#
# Copies the environment files that this machine's profile asks for from ./env/
# into $HOME. The list lives in profiles/<profile>/env.manifest.
#
# Manifest directives, one per line. Blank lines, and lines whose first
# non-blank character is #, are ignored:
#
#   none                      copy nothing. Only valid on its own, and the way
#                             a profile says it wants no files rather than
#                             having lost them to a typo.
#   group   <label>           print a heading
#   file    <src> <dest-dir>  copy one file into the <dest-dir> directory
#   dir     <src> <dest>      replace <dest> with a copy of the <src> directory
#   subdirs <src> <dest>      replace each immediate subdirectory of <src>
#                             inside <dest>, leaving the rest of <dest> alone
#   command <name> <prefix>   install ./commands/<name> as <prefix>/lib/<name>,
#                             with a symlink at <prefix>/bin/<name>
#
# <src> is relative to ./env/ and must exist. <dest> may use $HOME, and must
# be $HOME or a path below it. A command <name> is relative to ./commands/ and
# its <prefix> follows the same rules as a <dest>.
#
# The whole manifest is checked before anything is copied, so a mistake in it
# stops the run rather than leaving $HOME half synced.
#
# To test against a fake home:
# mkdir -p /tmp/fakehome && HOME=/tmp/fakehome commands/sync-env/sync-env
#
# Arguments:
#   --profile  The use-case of this machine, named by a directory under
#              ./profiles/. Only needed the first time: the name is saved and
#              reused. $DOTFILES_PROFILE overrides both, without saving.
#   --dry      Print what would be copied without making any changes.

set -eo pipefail

# Lookup order: commands/README.md, "Finding the checkout".
dotfiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)"
[[ -d "$dotfiles_dir/profiles" ]] ||
  dotfiles_dir="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/checkout" 2>/dev/null || true)"
dotfiles_dir="${DOTFILES_DIR:-$dotfiles_dir}"
if [[ ! -d "$dotfiles_dir/profiles" ]]; then
  echo "sync-env: no dotfiles checkout found. Run sync-env from one, or set \$DOTFILES_DIR." >&2
  exit 1
fi
source "$dotfiles_dir/lib/platform.sh"
source "$dotfiles_dir/lib/profile.sh"

# Location of environment files
DEV_ENV="$dotfiles_dir/env"

# Location of the commands
DEV_COMMANDS="$dotfiles_dir/commands"

dry="0"
profile_arg=""

while [[ $# -gt 0 ]]; do
  case "$1" in
  --dry)
    dry="1"
    ;;
  --profile)
    shift
    profile_arg="${1:-}"
    if [[ -z "$profile_arg" ]]; then
      echo "sync-env: --profile needs a name (one of: $(profile_list))" >&2
      exit 1
    fi
    ;;
  --profile=*)
    profile_arg="${1#--profile=}"
    ;;
  *)
    echo "sync-env: unknown argument '$1'" >&2
    exit 1
    ;;
  esac
  shift
done

die() {
  printf 'sync-env: %s\n' "$1" >&2
  exit 1
}

log() {
  if [[ $dry == "1" ]]; then
    echo "[DRY RUN]: $@"
  else
    echo "$@"
  fi
}

execute() {
  log "execute $@"
  if [[ $dry == "1" ]]; then
    return
  fi

  "$@"
}

profile="$(resolve_profile "$profile_arg" "$dry")"
manifest="$dotfiles_dir/profiles/$profile/env.manifest"

[[ -f "$manifest" ]] || die "no manifest for profile '$profile' at $manifest"

# ---------------------------------------------------
# Pass 1: read and check the manifest
# ---------------------------------------------------

# Each action is "<directive>|<absolute src>|<absolute dest>". A group carries
# its label in the src field.
actions=()
lineno=0

# Set by the `none` directive. A profile that copies nothing is legitimate, but
# so is a manifest whose every line was commented out by mistake, and the two
# look the same. `none` tells them apart.
copies_nothing="0"

while IFS= read -r line || [[ -n "$line" ]]; do
  lineno=$((lineno + 1))
  where="$manifest:$lineno"

  # Blank lines and whole-line comments.
  [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue

  read -r directive rest <<<"$line"

  if [[ "$directive" == "group" ]]; then
    [[ -n "$rest" ]] || die "$where: group needs a label"
    actions+=("group|$rest|")
    continue
  fi

  if [[ "$directive" == "none" ]]; then
    [[ -z "$rest" ]] || die "$where: none takes no arguments"
    copies_nothing="1"
    continue
  fi

  read -r src dest extra <<<"$rest"

  # A command is read from ./commands/ rather than ./env/, so the directive
  # decides which tree its source is relative to.
  case "$directive" in
  file | dir | subdirs)
    src_root="$DEV_ENV"
    src_label="env/"
    ;;
  command)
    src_root="$DEV_COMMANDS"
    src_label="commands/"
    ;;
  *) die "$where: unknown directive '$directive'" ;;
  esac

  [[ -n "$src" && -n "$dest" ]] || die "$where: $directive needs a source and a destination"
  [[ -z "$extra" ]] || die "$where: too many fields ('$extra')"
  [[ "$src" != /* ]] || die "$where: source '$src' must be relative to $src_label"
  [[ "/$src/" != */../* ]] || die "$where: source '$src' must not leave $src_label"

  dest="${dest//\$HOME/$HOME}"
  [[ "$dest" != *'$'* ]] || die "$where: destination '$dest' has an unknown variable"
  [[ "$dest" == "$HOME" || "$dest" == "$HOME"/* ]] ||
    die "$where: destination '$dest' is outside \$HOME"

  src="$src_root/$src"

  case "$directive" in
  file)
    [[ -f "$src" ]] || die "$where: '$src' is not a file"
    ;;
  dir | subdirs)
    [[ -d "$src" ]] || die "$where: '$src' is not a directory"
    # dir and subdirs both remove a path before copying, so neither may
    # target $HOME itself.
    [[ "$dest" != "$HOME" ]] || die "$where: $directive cannot target \$HOME itself"
    ;;
  command)
    [[ -d "$src" ]] || die "$where: '$src' is not a directory"
    # The entry point carries the command's name, because that is the name the
    # symlink on PATH gets.
    [[ -x "$src/$(basename "$src")" ]] ||
      die "$where: '$src' holds no executable $(basename "$src")"
    ;;
  esac

  actions+=("$directive|$src|$dest")
done <"$manifest"

if [[ "$copies_nothing" == "1" ]]; then
  [[ ${#actions[@]} -eq 0 ]] ||
    die "$manifest: none cannot be combined with another directive"
  log "$profile copies no environment files"
  exit 0
fi

[[ ${#actions[@]} -gt 0 ]] ||
  die "$manifest lists nothing to copy. Use the 'none' directive when that is deliberate."

# ---------------------------------------------------
# Pass 2: copy
# ---------------------------------------------------

copy_file() {
  local src="$1" dest="$2" name
  name="$(basename "$src")"

  execute mkdir -p "$dest"
  execute rm -f "$dest/$name"
  execute cp "$src" "$dest/$name"
}

copy_dir() {
  local src="$1" dest="$2"

  execute mkdir -p "$(dirname "$dest")"
  execute rm -rf "$dest"
  execute cp -r "$src" "$dest"
}

copy_subdirs() {
  local src="$1" dest="$2" sub name

  execute mkdir -p "$dest"
  while IFS= read -r sub; do
    name="$(basename "$sub")"
    execute rm -rf "$dest/$name"
    execute cp -r "$sub" "$dest/$name"
  done < <(find "$src" -mindepth 1 -maxdepth 1 -type d | sort)
}

# A command is a directory of shell rather than one file: an entry point, and a
# lib/ it sources. The tree is installed whole and reached through a symlink on
# PATH, which the entry point resolves to find its own lib/.
install_command() {
  local src="$1" prefix="$2" name
  name="$(basename "$src")"

  # What bounds the rm -rf below. Pass 1 rejects a prefix outside $HOME, and
  # asserting it again here keeps the bound where the removal can be read.
  [[ -n "$name" ]] || die "a command with no name: '$src'"
  [[ "$prefix" == "$HOME" || "$prefix" == "$HOME"/* ]] ||
    die "refusing to install into '$prefix', which is outside \$HOME"

  execute mkdir -p "$prefix/lib" "$prefix/bin"

  # Replaced whole, so a file dropped from the command disappears here too.
  execute rm -rf "$prefix/lib/$name"
  execute cp -r "$src" "$prefix/lib/$name"

  execute ln -sfn "$prefix/lib/$name/$name" "$prefix/bin/$name"
}

# The installed commands sit outside any checkout, and read its path from here.
record_checkout() {
  local file="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/checkout"

  log "record checkout $dotfiles_dir in $file"
  [[ $dry == "1" ]] && return
  mkdir -p "$(dirname "$file")"
  printf '%s\n' "$dotfiles_dir" >"$file"
}

log "------------ sync-env ------------"
log "profile: $profile"
record_checkout

for action in "${actions[@]}"; do
  directive="${action%%|*}"
  rest="${action#*|}"
  src="${rest%%|*}"
  dest="${rest#*|}"

  case "$directive" in
  group)
    echo "---------------------------"
    echo "$src:"
    ;;
  file) copy_file "$src" "$dest" ;;
  dir) copy_dir "$src" "$dest" ;;
  subdirs) copy_subdirs "$src" "$dest" ;;
  command) install_command "$src" "$dest" ;;
  esac
done

echo "----------------------------------------"
echo "Environment setup complete"
