#!/usr/bin/env bash
#
# Usage: sync-skills [--dry]
#
# Copies the skills in ./env/.agents/ into the agent-skills kit, which is how
# they reach a sandbox. The copy is generated and gitignored: the kit is loaded
# from this working tree (sbx-up builds $dotfiles/sbx/kits/mixins/<name>), so
# there is nothing to commit and nothing that can drift.
#
# sbx-up runs this before it starts a sandbox. Run it by hand after editing a
# skill if you are starting a sandbox another way.
#
# Two sources, in order, so that a local copy shadows a tracked skill of the
# same name:
#
#   env/.agents/skills/        tracked
#   env/.agents/skills-local/  untracked scratch
#
# A directory is a skill only if it holds a SKILL.md.
#
# LAYOUT decides where the kit puts them:
#
#   hooks   The payload lands at ~/skills, and the kit's setup hooks copy it
#           into ~/.claude/skills and ~/.agents/skills. Safe whatever the
#           runtime does with kit files under ~/.claude.
#   direct  The payload lands at ~/.claude/skills and ~/.agents/skills, with no
#           hooks at all. Only correct if the runtime keeps kit files under
#           ~/.claude, which it does not today: ~/.claude is a sandbox-reserved
#           path and a kit file placed there is discarded. Check this again
#           before using it.
#
# Arguments:
#   --dry  Print what would be copied without making any changes.

set -eo pipefail

# Lookup order: commands/README.md, "Finding the checkout".
dotfiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)"
[[ -d "$dotfiles_dir/profiles" ]] ||
  dotfiles_dir="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/checkout" 2>/dev/null || true)"
dotfiles_dir="${DOTFILES_DIR:-$dotfiles_dir}"
if [[ ! -d "$dotfiles_dir/profiles" ]]; then
  echo "sync-skills: no dotfiles checkout found. Run sync-env from one, or set \$DOTFILES_DIR." >&2
  exit 1
fi
tracked="$dotfiles_dir/env/.agents/skills"
local_skills="$dotfiles_dir/env/.agents/skills-local"
source "$dotfiles_dir/lib/style.sh"
kit_home="$dotfiles_dir/sbx/kits/mixins/agent-skills/files/home"

LAYOUT="${SKILLS_LAYOUT:-hooks}"

dry="0"

die() {
  printf 'sync-skills: %s\n' "$1" >&2
  exit 1
}

# execute runs a command. A dry run prints it instead, muted under the status
# line of its destination.
execute() {
  if [[ $dry == "1" ]]; then
    status_note "$*"
    return
  fi

  "$@"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --dry) dry="1" ;;
  -h | --help)
    awk 'NR > 2 && !/^#/ { exit } NR > 2 { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
    exit 0
    ;;
  *) die "unknown argument '$1'" ;;
  esac
  shift
done

[[ -d "$tracked" ]] || die "no skills at $tracked"

case "$LAYOUT" in
hooks) destinations=("$kit_home/skills") ;;
direct) destinations=("$kit_home/.claude/skills" "$kit_home/.agents/skills") ;;
*) die "LAYOUT must be 'hooks' or 'direct', not '$LAYOUT'" ;;
esac

# Every path this script owns, whatever the layout. All of them are removed
# first, so that changing LAYOUT does not leave the other layout's payload
# behind to ship alongside the new one.
managed=("$kit_home/skills" "$kit_home/.claude" "$kit_home/.agents")

# count_skills prints how many skills $1 holds. A directory with no SKILL.md
# is not a skill.
count_skills() {
  local dir count=0
  [[ -d "$1" ]] || {
    echo 0
    return
  }
  for dir in "$1"/*/; do
    [[ -f "$dir/SKILL.md" ]] && count=$((count + 1))
  done
  echo "$count"
}

# Copies every skill in $1 into $2, leaving anything already there alone unless
# it has the same name.
copy_skills() {
  local src="$1" dest="$2" dir name

  [[ -d "$src" ]] || return 0

  for dir in "$src"/*/; do
    [[ -d "$dir" ]] || continue
    [[ -f "$dir/SKILL.md" ]] || continue

    name="$(basename "$dir")"
    execute rm -rf "$dest/$name"
    execute cp -R "${dir%/}" "$dest/$name"
  done
}

heading "sync-skills: $LAYOUT layout"
[[ "$dry" == "1" ]] && echo "Dry run: nothing changes"
echo

count_tracked="$(count_skills "$tracked")"
count_local="$(count_skills "$local_skills")"

for i in "${!destinations[@]}"; do
  dest="${destinations[$i]}"
  if [[ "$dry" == "1" ]]; then
    status copy "${dest#"$dotfiles_dir"/}" "$count_tracked tracked, $count_local local"
  else
    status copied "${dest#"$dotfiles_dir"/}" "$count_tracked tracked, $count_local local"
  fi

  # Removed before the first copy. See $managed.
  if [[ $i -eq 0 ]]; then
    for path in "${managed[@]}"; do
      execute rm -rf "$path"
    done
  fi

  execute mkdir -p "$dest"
  copy_skills "$tracked" "$dest"
  copy_skills "$local_skills" "$dest"
done

echo
if [[ "$dry" == "1" ]]; then
  verdict copy "sync-skills: $count_tracked tracked and $count_local local skills to copy"
else
  verdict ok "sync-skills: $count_tracked tracked and $count_local local skills in the kit payload"
fi
