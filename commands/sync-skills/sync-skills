#!/usr/bin/env bash
#
# Usage: sync-skills [--dry]
#
# Copies the skills in ./env/.agents/ into the agent-skills kit, which is how
# they reach a sandbox, and writes the kit's descriptor with one agent-skill@1
# entry for each skill. Both are generated and gitignored: the kit is built
# from this working tree (sbx-up names $dotfiles/sbx/kits/mixins/<name>), so
# there is nothing to commit and nothing that can drift.
#
# sbx-up runs this before it starts a sandbox. Run it by hand after editing a
# skill if you are starting a sandbox another way.
#
# Two sources, in order, so that a local copy shadows a tracked skill of the
# same name:
#
#   env/.agents/skills/        tracked
#   env/.agents/skills-local/  untracked scratch
#
# A directory is a skill only if it holds a SKILL.md. A skill whose name the
# runtime refuses (see `valid_name`) is left out, with a warning.
#
# What it writes, in sbx/kits/mixins/agent-skills/:
#
#   skills/<name>/      a copy of each skill, which agent-skills.dockerfile
#                       copies to /usr/share/agent-skills/<name>
#   agent-skills.yaml   descriptor.yaml.tmpl, then one entry per skill
#
# Arguments:
#   --dry  Print what would be copied without making any changes.

set -eo pipefail

# Lookup order: commands/README.md, "Finding the checkout".
dotfiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)"
[[ -d "$dotfiles_dir/profiles" ]] ||
  dotfiles_dir="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/checkout" 2>/dev/null || true)"
dotfiles_dir="${DOTFILES_DIR:-$dotfiles_dir}"
if [[ ! -d "$dotfiles_dir/profiles" ]]; then
  echo "sync-skills: no dotfiles checkout found. Run sync-env from one, or set \$DOTFILES_DIR." >&2
  exit 1
fi
tracked="$dotfiles_dir/env/.agents/skills"
local_skills="$dotfiles_dir/env/.agents/skills-local"
source "$dotfiles_dir/lib/style.sh"
kit="$dotfiles_dir/sbx/kits/mixins/agent-skills"
template="$kit/descriptor.yaml.tmpl"
descriptor="$kit/agent-skills.yaml"
payload="$kit/skills"

# The directory in the image that agent-skills.dockerfile copies the skills to.
image_dir="/usr/share/agent-skills"

dry="0"

die() {
  printf 'sync-skills: %s\n' "$1" >&2
  exit 1
}

# execute runs a command. A dry run prints it instead, muted under the status
# line of its destination.
execute() {
  if [[ $dry == "1" ]]; then
    local line="$*"
    status_note "${line//"$dotfiles_dir"\//}"
    return
  fi

  "$@"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --dry) dry="1" ;;
  -h | --help)
    awk 'NR > 2 && !/^#/ { exit } NR > 2 { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
    exit 0
    ;;
  *) die "unknown argument '$1'" ;;
  esac
  shift
done

[[ -d "$tracked" ]] || die "no skills at $tracked"
[[ -f "$template" ]] || die "no descriptor template at $template"

# valid_name succeeds when the runtime accepts $1 as a skill name
# (agent-skill@1: [A-Za-z0-9][A-Za-z0-9._-]*, at most 255 bytes).
valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && ${#1} -le 255 ]]
}

# is_skill succeeds when $1 is a directory that holds a SKILL.md.
is_skill() {
  [[ -f "$1/SKILL.md" ]]
}

# Every skill as "name<TAB>source", sorted by name. A local skill replaces a
# tracked skill of the same name. Nothing here needs bash 4, because sbx-up
# runs this on the host, and macOS ships bash 3.2.
skipped=()
entries=""
for src in "$tracked" "$local_skills"; do
  [[ -d "$src" ]] || continue
  for dir in "$src"/*/; do
    dir="${dir%/}"
    is_skill "$dir" || continue
    name="$(basename "$dir")"
    if [[ "$src" == "$tracked" ]] && is_skill "$local_skills/$name"; then
      continue
    fi
    if ! valid_name "$name"; then
      skipped+=("$name")
      continue
    fi
    entries+="$name"$'\t'"$dir"$'\n'
  done
done
entries="$(printf '%s' "$entries" | LC_ALL=C sort)"

names=()
dirs=()
while IFS=$'\t' read -r name dir; do
  [[ -n "$name" ]] || continue
  names+=("$name")
  dirs+=("$dir")
done <<<"$entries"

count_tracked=0
count_local=0
for dir in "${dirs[@]}"; do
  if [[ "$dir" == "$local_skills"/* ]]; then
    count_local=$((count_local + 1))
  else
    count_tracked=$((count_tracked + 1))
  fi
done

heading "sync-skills: ${kit#"$dotfiles_dir"/}"
[[ "$dry" == "1" ]] && echo "Dry run: nothing changes"
echo

for name in "${skipped[@]}"; do
  status warn "$name" "not a valid skill name, so it is left out"
done

if [[ "$dry" == "1" ]]; then
  status copy "skills/" "$count_tracked tracked, $count_local local"
else
  status copied "skills/" "$count_tracked tracked, $count_local local"
fi

# The payload is replaced whole, so a skill removed from the source leaves the
# kit too.
execute rm -rf "$payload"
execute mkdir -p "$payload"
for i in "${!names[@]}"; do
  execute cp -R "${dirs[$i]}" "$payload/${names[$i]}"
done

if [[ "$dry" == "1" ]]; then
  status copy "agent-skills.yaml" "${#names[@]} agent-skill entries"
  status_note "write ${descriptor#"$dotfiles_dir"/} from ${template#"$dotfiles_dir"/}"
else
  {
    cat "$template"
    for name in "${names[@]}"; do
      printf '\n  - type: com.docker.sandbox/agent-skill@1\n'
      printf '    optional: true\n'
      printf '    config:\n'
      printf '      path: %s/%s\n' "$image_dir" "$name"
    done
  } >"$descriptor"
  status ok "agent-skills.yaml" "${#names[@]} agent-skill entries"
fi

summary="$count_tracked tracked and $count_local local skills"
worst=ok
[[ "$dry" == "1" ]] && worst=copy
if [[ ${#skipped[@]} -gt 0 ]]; then
  summary+=", ${#skipped[@]} left out"
  worst=warn
fi

echo
if [[ "$dry" == "1" ]]; then
  verdict "$worst" "sync-skills: $summary to copy"
else
  verdict "$worst" "sync-skills: $summary in the kit"
fi
