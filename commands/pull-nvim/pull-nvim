#!/usr/bin/env bash
#
# Usage: pull-nvim [--dry]
#
# Copies nvim config from ~/.config/nvim into ./env/.config/nvim.
#
# Arguments:
#   --dry  Print what would be executed without making any changes.

set -eo pipefail

# Lookup order: commands/README.md, "Finding the checkout".
dotfiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)"
[[ -d "$dotfiles_dir/profiles" ]] ||
  dotfiles_dir="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/checkout" 2>/dev/null || true)"
dotfiles_dir="${DOTFILES_DIR:-$dotfiles_dir}"
if [[ ! -d "$dotfiles_dir/profiles" ]]; then
  echo "pull-nvim: no dotfiles checkout found. Run sync-env from one, or set \$DOTFILES_DIR." >&2
  exit 1
fi
dry="0"

while [[ $# > 0 ]]; do
  if [[ $1 == "--dry" ]]; then
    dry="1"
  fi
  shift
done

log() {
  if [[ $dry == "1" ]]; then
    echo "[DRY RUN]: $@"
  else
    echo "$@"
  fi
}

execute() {
  log "execute $@"
  if [[ $dry == "1" ]]; then
    return
  fi

  "$@"
}

execute rm -rf "$dotfiles_dir/env/.config/nvim"
execute cp -r ~/.config/nvim "$dotfiles_dir/env/.config/nvim"
