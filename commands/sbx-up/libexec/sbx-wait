#!/usr/bin/env bash
#
# sbx-wait [--dotfiles] [--timeout <seconds>] <name>
#
# Waits for a Docker Sandbox to become usable, and says what it is waiting for
# while it does. It is in libexec/ because the shell window is a process tmux
# starts, so this is run rather than sourced.
#
# It runs first in that window, so the shell starts on a sandbox that is
# already configured.
#
# There are two stages:
#
#   1. `sbx run` is still creating and starting the container, so `sbx exec`
#      does not answer yet. This stage always runs.
#   2. With --dotfiles, the dotfiles kit is still cloning the repo and
#      installing packages. This stage reads the status file the kit writes and
#      names the step, so a slow start is never a blank screen.
#
# Exit status:
#   0   the sandbox is ready
#   1   stage 1 timed out; the sandbox is not usable
#   2   stage 2 timed out or the kit failed; the sandbox answers but is not
#       configured, so the caller can still open a shell in it
#   64  bad arguments

set -uo pipefail

dotfiles=0
timeout=300
name=""

usage() {
  printf 'usage: sbx-wait [--dotfiles] [--timeout <seconds>] <name>\n' >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --dotfiles) dotfiles=1 ;;
  --timeout)
    shift
    timeout="${1:-}"
    ;;
  --timeout=*) timeout="${1#--timeout=}" ;;
  -h | --help)
    usage
    exit 0
    ;;
  -*)
    printf 'sbx-wait: unknown option %s\n' "$1" >&2
    usage
    exit 64
    ;;
  *) name="$1" ;;
  esac
  shift
done

if [[ -z "$name" || ! "$timeout" =~ ^[0-9]+$ ]]; then
  usage
  exit 64
fi

if ! command -v sbx >/dev/null 2>&1; then
  printf 'sbx-wait: sbx is not installed\n' >&2
  exit 1
fi

# $SECONDS counts from the start of the script, which is also what the reader
# wants to see: how long they have been waiting in total.
SECONDS=0

clock() {
  printf '%d:%02d' "$((SECONDS / 60))" "$((SECONDS % 60))"
}

# On a terminal the progress is one line, redrawn in place. Anywhere else
# (a pipe, a log) the same text is printed once per change, since a redraw
# there is just noise.
interactive=0
[[ -t 1 ]] && interactive=1

frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
frame=0
last=""

draw() {
  local text="$1"
  if ((interactive)); then
    printf '\r\033[2K  %s  %5s  %s' "${frames[frame]}" "$(clock)" "$text"
    frame=$(((frame + 1) % ${#frames[@]}))
  elif [[ "$text" != "$last" ]]; then
    printf '     %5s  %s\n' "$(clock)" "$text"
  fi
  last="$text"
}

# note ends the progress line and prints a result in its place.
note() {
  local mark="$1" text="$2"
  if ((interactive)); then
    printf '\r\033[2K'
  fi
  printf '  %s  %s\n' "$mark" "$text"
  last=""
}

# A poll costs one `sbx exec` round trip, so it runs about once a second while
# the spinner keeps moving at ten frames a second in between.
spin() {
  local text="$1" i
  for ((i = 0; i < 10; i++)); do
    draw "$text"
    sleep 0.1
  done
}

# `~` in an `sbx exec` command is expanded by this shell and never reaches the
# container, so everything below uses $HOME inside single quotes instead.
in_sandbox() {
  sbx exec "$name" -- sh -c "$1" 2>/dev/null
}

kit_log() {
  note '·' 'the last 30 lines of the kit log:'
  in_sandbox 'tail -n 30 "$HOME/.dotfiles-kit.log"' || true
}

printf '\n  sbx-up: preparing the %s sandbox\n\n' "$name"

# ---------------------------------------------------------------------------
# Stage 1: the container is starting.
# ---------------------------------------------------------------------------

draw 'starting the sandbox'
until sbx exec "$name" -- true >/dev/null 2>&1; do
  if ((SECONDS >= timeout)); then
    note '✗' "timed out after ${timeout}s waiting for the $name sandbox"
    exit 1
  fi
  spin 'starting the sandbox'
done

if ((dotfiles == 0)); then
  note '✓' "ready in $(clock)"
  exit 0
fi

# ---------------------------------------------------------------------------
# Stage 2: the dotfiles kit is configuring the sandbox.
#
# The kit writes one short phrase to ~/.dotfiles-kit.status per step, then
# `ready` when it finishes or `failed` when it does not. Reading it turns the
# wait into a progress report, and makes a failure visible at once instead of
# after the full timeout.
# ---------------------------------------------------------------------------

while :; do
  status="$(in_sandbox 'cat "$HOME/.dotfiles-kit.status"' || true)"
  status="${status%%$'\n'*}"

  case "$status" in
  ready) break ;;
  failed)
    note '✗' 'the dotfiles kit failed'
    kit_log
    exit 2
    ;;
  esac

  if ((SECONDS >= timeout)); then
    note '✗' "timed out after ${timeout}s waiting for the dotfiles kit"
    kit_log
    exit 2
  fi

  spin "${status:-waiting for the dotfiles kit}"
done

note '✓' "ready in $(clock)"

# The kit installs the nvim plugins in the background, so the shell does not
# wait for them. Say so, because an nvim opened too early installs them in the
# foreground instead and looks stuck.
nvim_status="$(in_sandbox 'cat "$HOME/.dotfiles-kit.nvim-status"' || true)"
nvim_status="${nvim_status%%$'\n'*}"
case "$nvim_status" in
ready | '') ;;
failed) note '!' 'the nvim plugin install failed; see ~/.dotfiles-kit.nvim.log' ;;
*) note '·' "$nvim_status, in the background; give nvim a minute" ;;
esac
