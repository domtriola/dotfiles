#!/usr/bin/env bash
#
# Starts a Docker sandbox for the current project, in its own tmux windows.
#
# Run it from anywhere inside a project. The verbs live in lib/ beside this
# file, and `sbx-up --help` is the reference.

set -euo pipefail

# The command directory, resolved through any symlink, so that the same file
# works from a checkout and from ~/.local/bin.
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  target="$(readlink "$self")"
  [[ "$target" == /* ]] || target="$(dirname "$self")/$target"
  self="$target"
done
pkg="$(cd "$(dirname "$self")" >/dev/null 2>&1 && pwd)"

for f in "$pkg"/lib/*; do
  [[ -f "$f" ]] || continue
  # shellcheck source=/dev/null
  source "$f"
done

usage() {
  cat <<'EOF'
Usage:
  sbx-up [--no-gh] [agent]

Starts a Docker sandbox for the current project in a new tmux window, named
after the project directory and the checked-out branch. An existing sandbox of
that name is removed first, so every start begins from fresh state.

No shell window opens. The agent commits and pushes on its own, and
`sbx-shell <name>` opens a shell into the sandbox when one is needed.

Outside tmux the sandbox runs in the current terminal, and no window opens.

The sandbox gets a GitHub token from sbx-token that reaches only the project's
repositories, and that sbx renews while the sandbox runs. If no token can be
minted, nothing is started or removed. See `sbx-token --help`.

Arguments:
  agent       A kit under sbx/kits/sandboxes, or a path to any kit. Overrides
              the "agent" setting for this run.

Options:
  --no-gh     Start the sandbox without a GitHub token of its own. A global
              github secret, if one is stored, still applies.

Examples:
  sbx-up
  sbx-up pi-ailo
  sbx-up ~/src/other-repo/kits/its-agent

Per-project settings live in a .sbx.json at the project root. Every key is
optional:

  agent     the sandbox kit to run, which the argument above overrides.
            Default: my-claude
  kits      the kits mixed into the sandbox.
            Default: agent-skills, dotfiles
  memory    the memory limit passed to `sbx run`.
            Default: 4g
  clone     give the sandbox its own clone instead of the host worktree.
            Default: false
  repos     the repositories the GitHub token reaches, as owner/name. They
            must have one owner.
            Default: the repository of the origin remote
  permissions
            token permissions over the defaults of sbx-token, for example
            {"workflows": "write", "issues": "none"}.
            Default: {}

A kit value that holds a / is a path. Every other value names a kit in this
repository: an agent under sbx/kits/sandboxes, a mixin under sbx/kits/mixins.

Environment:
  SBX_UP_DOTFILES     the checkout that holds the kits and sync-skills.
                      Default: ~/src/personal/dotfiles
  SBX_KIT_ARGS_FILE   values for a sandbox kit that declares arguments.
                      Default: ~/.config/sbx/kit.args
EOF
}

agent=""
use_gh="true"

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  --no-gh)
    use_gh="false"
    ;;
  -*)
    printf 'sbx-up: unknown argument %s. Run sbx-up --help.\n' "$1" >&2
    exit 1
    ;;
  *)
    if [[ -n "$agent" ]]; then
      printf 'sbx-up: only one agent can be named. Run sbx-up --help.\n' >&2
      exit 1
    fi
    agent="$1"
    ;;
  esac
  shift
done

require_deps
names_init
config_load "$root" "$name" "$agent"

# The token is minted before the old sandbox is removed, so a machine that
# cannot mint one keeps the sandbox it had. The secret is stored after,
# because `sbx rm` deletes the secrets of the sandbox it removes.
if [[ "$use_gh" == "true" ]]; then
  github_check
fi

rebuild_skills
remove_sandbox "$name"

if [[ "$use_gh" == "true" ]]; then
  github_register "$name"
fi

if [[ -z "${TMUX:-}" ]]; then
  exec "${run[@]}"
fi

tmux_clear_windows
tmux_open_agent
