#!/usr/bin/env bash
#
# The window a sandbox gets, and how it is launched.

# A window left over from the previous sandbox is attached to nothing. A shell
# window from sbx-shell closes by itself, because its `sbx exec` ends with the
# sandbox.
#
# Only an exact name match is killed, and never the window this was called
# from: tmux resolves a target it cannot match as a window against sessions and
# clients too, so a bare `kill-window -t "$window"` can take out an unrelated
# window.
tmux_clear_windows() {
  local current id existing

  current="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"

  while read -r id existing; do
    if [[ "$existing" == "$window" && "$id" != "$current" ]]; then
      tmux kill-window -t "$id" || true
    fi
  done < <(tmux list-windows -F '#{window_id} #{window_name}' 2>/dev/null || true)
}

# tmux_open_agent runs the sandbox through the shell, so a failure leaves the
# error on screen instead of closing the window with it.
tmux_open_agent() {
  local launch

  launch="$(printf '%q ' "${run[@]}")"
  launch+='|| { status=$?; printf "\nsbx-up: sbx exited with status %s\n" "$status"; '
  launch+='printf "Press enter to close this window... "; read -r _; }'

  tmux new-window -n "$window" "$launch"
}
