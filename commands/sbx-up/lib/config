#!/usr/bin/env bash
#
# What the sandbox is made of: the defaults here, the project's .sbx.json over
# them, and the agent named on the command line over both.

# A clone is the default because a sandbox that mounts the host worktree can
# write files that the host runs later, such as .git/hooks. A project outside
# git has nothing to clone, so it is mounted.
sbx_up_defaults='{"agent": "my-claude", "kits": ["agent-skills", "dotfiles"], "memory": "4g"}'

# sbx_up_profile prints this machine's profile, read the way lib/profile.sh
# saves it, or nothing when no profile is set. It does not call
# resolve_profile, which can ask a question and save the answer: sbx-up only
# reads the profile.
sbx_up_profile() {
  local file="${DOTFILES_PROFILE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/profile}"
  if [[ -n "${DOTFILES_PROFILE:-}" ]]; then
    printf '%s' "$DOTFILES_PROFILE"
  elif [[ -f "$file" ]]; then
    tr -d '[:space:]' <"$file"
  fi
}

# config_load resolves the settings for one sandbox and sets three globals:
#
#   run        the `sbx` command line, as an array
#   gh_repos   the "repos" setting, one per line, or nothing for origin
#   gh_perms   the "permissions" setting, as name=level, one per line
config_load() {
  local root="$1" name="$2" agent="$3"
  local config="$root/.sbx.json" given override plan arg spec in_git=false

  given="$([[ -f "$config" ]] && cat "$config" || echo '{}')"

  [[ -e "$root/.git" ]] && in_git=true

  override='{}'
  if [[ -n "$agent" ]]; then
    override="$(jq -n --arg agent "$agent" '{agent: $agent}')"
  fi

  # One pass: the three sources merged, and everything this reads off the
  # result. A setting of the wrong shape, such as a "kits" that is not a list,
  # fails here rather than part way through the answers.
  if ! plan="$(jq \
    --arg dotfiles "$sbx_up_dotfiles" \
    --arg name "$name" \
    --argjson defaults "$sbx_up_defaults" \
    --argjson in_git "$in_git" \
    --argjson override "$override" '
    def kit($kind):
      if test("/") then . else "\($dotfiles)/sbx/kits/\($kind)/\(.)" end;

    ($defaults * {clone: $in_git} * . * $override)
    | {
        args: (
          ["run", (.agent | kit("sandboxes")), "--name", $name, "--memory", .memory]
          + (if .clone then ["--clone"] else [] end)
          + (.kits | map("--kit", kit("mixins")))
        ),
        repos: (.repos // [] | if type == "array" and all(type == "string") then . else error("repos") end),
        perms: (.permissions // {} | if type == "object" and all(type == "string")
          then to_entries | map("\(.key)=\(.value)") else error("permissions") end),
        spec: ((.agent | kit("sandboxes")) + "/spec.yaml")
      }
  ' <<<"$given")"; then
    die "could not read $config"
  fi

  # Agents on agent-server run for hours with no one watching. A mounted
  # worktree would let one write files that the box runs later, so every
  # sandbox there is a clone (agent-server-I13 in
  # docs/threat-model/profile-agent-server.md). The resolved plan is checked,
  # not the file, so that any value that turns the clone off is caught.
  if [[ "$(sbx_up_profile)" == "agent-server" ]] && ! jq -e '.args | index("--clone")' <<<"$plan" >/dev/null; then
    if [[ "$in_git" == true ]]; then
      die "$config turns off the clone, which the agent-server profile does not allow. Remove \"clone\" from it."
    fi
    die "$root is not in git, so it cannot be cloned, and the agent-server profile does not mount a directory. Run sbx-up in a git clone."
  fi

  run=(sbx)
  while IFS= read -r arg; do
    run+=("$arg")
  done < <(jq -r '.args[]' <<<"$plan")

  gh_repos="$(jq -r '.repos[]' <<<"$plan")"
  gh_perms="$(jq -r '.perms[]' <<<"$plan")"

  # `sbx` rejects an argument that no resolved kit declares, so the file is
  # passed only to a sandbox kit that asks for one. The check reads the kit's
  # spec, so a kit named by a URL or a zip is left alone and takes --kit-arg
  # by hand.
  spec="$(jq -r '.spec' <<<"$plan")"
  if [[ ! -d "$(dirname "$spec")" ]]; then
    die "sandbox kit not found: $spec"
  fi
  if [[ -f "$sbx_up_kit_args_file" && -f "$spec" ]] && grep -q '^args:' "$spec"; then
    run+=(--kit-args-file "$sbx_up_kit_args_file")
  fi
}
