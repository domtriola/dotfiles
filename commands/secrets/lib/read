#!/usr/bin/env bash
#
# keys, get and run: the verbs that read a scope and change nothing.

# list_keys <project> [<scope>] prints the scopes of a project, or the keys of
# one scope. It never prints a value.
list_keys() {
  local project="$1" scope="${2:-}" file lines
  [[ -d "$(secrets_home)/$project" ]] || die "there is no project $project in $(secrets_home)"
  if [[ -z "$scope" ]]; then
    for file in "$(secrets_home)/$project"/*.age; do
      [[ -f "$file" ]] || continue
      file="${file##*/}"
      printf '%s\n' "${file%.age}"
    done
    return
  fi
  lines="$(decrypt_scope "$project" "$scope")" || exit 1
  key_names "$lines"
}

# get_value <project> <scope> <KEY> prints one value, with no newline, for a
# program that reads it through a pipe.
get_value() {
  local lines value
  [[ ! -t 1 ]] || die "get prints a secret, so it does not print to a terminal. Pipe it into the program that reads it."
  lines="$(decrypt_scope "$1" "$2")" || exit 1
  secrets_lookup value "$lines" "$3" || die "$1/$2 has no $3. Run secrets keys $1 $2."
  printf '%s' "$value"
}

# run_with <project> <scope> <command>... runs the command with each key of the
# scope in its environment, and nothing from any other scope.
run_with() {
  local project="$1" scope="$2" lines line
  shift 2
  lines="$(decrypt_scope "$project" "$scope")" || exit 1
  while IFS= read -r line; do
    # Each line is KEY=value, so this exports KEY, and not the variable line.
    # shellcheck disable=SC2163
    [[ "$line" == *=* ]] && export "$line"
  done < <(printf '%s\n' "$lines")
  unset lines line
  exec "$@"
}
