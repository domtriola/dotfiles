#!/usr/bin/env bash
#
# set: ask for values, and replace their keys in a scope.

# set_keys <project> <scope> <KEY>... asks for all values first, so that the
# YubiKey touch for the decrypt comes after the typing.
set_keys() {
  local project="$1" scope="$2" key value line lines="" kept="" values=() i
  shift 2
  for key in "$@"; do
    valid_key "$key"
  done
  require_recipients "$project"

  for key in "$@"; do
    printf '%s: ' "$key" >&2
    IFS= read -rs value || die "no value for $key"
    [[ -t 0 ]] && printf '\n' >&2
    [[ -n "$value" ]] || die "the value of $key is empty"
    values+=("$value")
  done

  if [[ -f "$(secrets_scope_file "$project" "$scope")" ]]; then
    lines="$(decrypt_scope "$project" "$scope")" || exit 1
  fi
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    for key in "$@"; do
      [[ "$line" == "$key="* ]] && continue 2
    done
    kept+="$line"$'\n'
  done < <(printf '%s\n' "$lines")
  i=0
  for key in "$@"; do
    kept+="$key=${values[$i]}"$'\n'
    i=$((i + 1))
  done

  printf '%s' "$kept" | secrets_encrypt "$project" "$scope" ||
    die "age could not encrypt $project/$scope, so it is unchanged"
  note "set $(IFS=,; printf '%s' "$*" | sed 's/,/, /g') in $project/$scope"
}
