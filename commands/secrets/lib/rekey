#!/usr/bin/env bash
#
# rekey: encrypt each scope again, after a YubiKey is added or lost.

# rekey_scopes [<project>] encrypts every scope of the project, or of every
# project, to its current recipients. A scope that fails stops the run, and
# keeps its old file.
rekey_scopes() {
  local dir project file scope lines count=0
  for dir in "$(secrets_home)"/*/; do
    [[ -d "$dir" ]] || continue
    project="$(basename "$dir")"
    [[ -z "${1:-}" || "$project" == "$1" ]] || continue
    require_recipients "$project"
    for file in "$dir"*.age; do
      [[ -f "$file" ]] || continue
      scope="$(basename "$file" .age)"
      lines="$(decrypt_scope "$project" "$scope")" || exit 1
      printf '%s\n' "$lines" | secrets_encrypt "$project" "$scope" ||
        die "age could not encrypt $project/$scope, so it is unchanged"
      count=$((count + 1))
    done
  done
  [[ -z "${1:-}" || -d "$(secrets_home)/$1" ]] || die "there is no project $1 in $(secrets_home)"
  note "encrypted $count scopes again"
}
