#!/usr/bin/env bash
#
# Shared helpers: failure, and the checks that every verb makes first.
#
# Nothing in this command needs bash 4, so it runs with the bash 3.2 that macOS
# ships. The usual install directories are added to PATH, so that age finds
# age-plugin-yubikey.

PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

die() {
  printf 'secrets: %s\n' "$1" >&2
  exit 1
}

note() {
  printf 'secrets: %s\n' "$1" >&2
}

require_age() {
  command -v age >/dev/null 2>&1 || die "age is not installed, run setup 20_packages"
}

# A name is a path segment and a key is an environment variable, so each must
# be safe as one.
valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "\"$1\" is not a valid name. Use letters, digits, '.', '_' and '-'."
}

valid_key() {
  [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "\"$1\" is not a valid key. Use letters, digits and '_', as for an environment variable."
}

# require_recipients <project> fails when the scopes of the project have no
# one to be encrypted to.
require_recipients() {
  local file
  file="$(secrets_recipients "$1")"
  grep -q '^age1' "$file" 2>/dev/null || die "$file has no recipients. Run secrets init with a YubiKey inserted."
}

# decrypt_scope <project> <scope> prints the lines of the scope, or fails with
# the reason.
decrypt_scope() {
  [[ -f "$(secrets_scope_file "$1" "$2")" ]] || die "$1 has no scope $2. Run secrets keys $1."
  secrets_decrypt "$1" "$2" || die "cannot decrypt $1/$2. Insert a YubiKey that it is encrypted to."
}

# key_names <lines> prints the key of each KEY=value line.
key_names() {
  local line
  while IFS= read -r line; do
    [[ "$line" == *=* ]] && printf '%s\n' "${line%%=*}"
  done < <(printf '%s\n' "$1")
}
