#!/usr/bin/env bash
#
# init: make the store, and add the YubiKey that is inserted.

# init_store makes an age slot on the YubiKey if it has none, and adds the
# identity and the recipient of each slot that the store does not have yet.
init_store() {
  local home block line serial="" recipient="" added=0
  home="$(secrets_home)"
  mkdir -p "$home"
  chmod 700 "$home"
  touch "$home/identities.txt" "$home/recipients.txt"
  chmod 600 "$home/identities.txt" "$home/recipients.txt"

  command -v age-plugin-yubikey >/dev/null 2>&1 || die "age-plugin-yubikey is not installed, run setup 20_packages"
  block="$(age-plugin-yubikey --identity 2>/dev/null || true)"
  if [[ "$block" != *AGE-PLUGIN-YUBIKEY-* ]]; then
    note "this YubiKey has no age slot, so one is made. Enter the PIV PIN, and touch the key when it blinks."
    block="$(age-plugin-yubikey --generate --pin-policy once --touch-policy always)" ||
      die "could not make an age slot. Insert one YubiKey, and run secrets init again."
  fi

  # The plugin prints a block of comments for each slot, then its identity:
  #   #       Serial: 15301920, Slot: 1
  #   #    Recipient: age1yubikey1...
  #   AGE-PLUGIN-YUBIKEY-1...
  while IFS= read -r line; do
    case "$line" in
    "#"*"Serial: "*) serial="${line#*Serial: }" ;;
    "#"*"Recipient: "*) recipient="${line#*Recipient: }" ;;
    AGE-PLUGIN-YUBIKEY-*)
      if grep -qxF "$line" "$home/identities.txt"; then
        note "the YubiKey $serial is in the store already"
      else
        printf '# Serial: %s\n%s\n' "$serial" "$line" >>"$home/identities.txt"
        printf '# Serial: %s\n%s\n' "$serial" "$recipient" >>"$home/recipients.txt"
        note "added the YubiKey $serial"
        added=$((added + 1))
      fi
      ;;
    esac
  done < <(printf '%s\n' "$block")

  if [[ "$(grep -c '^age1' "$home/recipients.txt")" -lt 2 ]]; then
    note "the store has one YubiKey. Run secrets init again with the backup YubiKey inserted."
  elif [[ "$added" -gt 0 && -n "$(find "$home" -name '*.age' 2>/dev/null)" ]]; then
    note "run secrets rekey, so that the new YubiKey can decrypt the scopes that exist"
  fi
}
