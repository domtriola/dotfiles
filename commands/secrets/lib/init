#!/usr/bin/env bash
#
# init: make the store, and add the YubiKey that is inserted.

# init_store makes an age slot on the YubiKey if it has none, and adds the
# identity and the recipient of each slot that the store does not have yet.
# Only one YubiKey can be inserted, so that the slot is made on the key that
# the operator means.
init_store() {
  local home serials serial block line slot="" recipient="" count
  home="$(secrets_home)"
  mkdir -p "$home"
  chmod 700 "$home"
  touch "$home/identities.txt" "$home/recipients.txt"
  chmod 600 "$home/identities.txt" "$home/recipients.txt"

  require_tool ykman
  require_tool age-plugin-yubikey
  serials="$(ykman list --serials 2>/dev/null || true)"
  [[ -n "$serials" && "$serials" != *$'\n'* ]] ||
    die "insert one YubiKey, and only one, then run secrets init again"
  serial="$serials"

  block="$(age-plugin-yubikey --identity --serial "$serial" 2>/dev/null || true)"
  if [[ "$block" != *AGE-PLUGIN-YUBIKEY-* ]]; then
    note "the YubiKey $serial has no age slot, so one is made. Enter the PIV PIN, and touch the key when it blinks."
    block="$(age-plugin-yubikey --generate --serial "$serial" --pin-policy once --touch-policy always)" ||
      die "could not make an age slot on the YubiKey $serial"
  fi

  # The plugin prints a block of comments for each slot, then its identity:
  #   #       Serial: 15301920, Slot: 1
  #   #    Recipient: age1yubikey1...
  #   AGE-PLUGIN-YUBIKEY-1...
  while IFS= read -r line; do
    case "$line" in
    "#"*"Serial: "*) slot="${line#*Serial: }" ;;
    "#"*"Recipient: "*) recipient="${line#*Recipient: }" ;;
    AGE-PLUGIN-YUBIKEY-*)
      if grep -qxF "$line" "$home/identities.txt"; then
        note "the YubiKey $serial is in the store already"
      else
        printf '# Serial: %s\n%s\n' "$slot" "$line" >>"$home/identities.txt"
        printf '# Serial: %s\n%s\n' "$slot" "$recipient" >>"$home/recipients.txt"
        note "added the YubiKey $serial"
        [[ -z "$(find "$home" -name '*.age' 2>/dev/null)" ]] ||
          note "run secrets rekey, so that this YubiKey can decrypt the scopes that exist"
      fi
      ;;
    esac
  done < <(printf '%s\n' "$block")

  count="$(grep -c '^age1' "$home/recipients.txt" || true)"
  if [[ "$count" -lt 2 ]]; then
    note "the store has 1 YubiKey. Run secrets init again with the backup YubiKey inserted."
  else
    note "the store has $count YubiKeys"
  fi
}
