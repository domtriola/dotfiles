#!/usr/bin/env bash
#
# A secret store for each project, which only my YubiKeys decrypt. Each scope
# of a project is one age file of KEY=value lines.
#
# The verbs live in lib/ beside this file, and `secrets --help` is the
# reference. lib/store.sh is also a library for a project's shell scripts.

set -euo pipefail

# Every file that this command makes is for this user only.
umask 077

# The command directory, resolved through any symlink, so that the same file
# works from a checkout and from ~/.local/bin.
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  target="$(readlink "$self")"
  [[ "$target" == /* ]] || target="$(dirname "$self")/$target"
  self="$target"
done
pkg="$(cd "$(dirname "$self")" >/dev/null 2>&1 && pwd)"

for f in "$pkg"/lib/*; do
  [[ -f "$f" ]] || continue
  # shellcheck source=/dev/null
  source "$f"
done

usage() {
  cat <<'EOF'
Usage:
  secrets init
  secrets set <project> <scope> <KEY>...
  secrets keys <project> [<scope>]
  secrets get <project> <scope> <KEY>
  secrets run <project> <scope> -- <command>...
  secrets rekey [<project>]

A project keeps its secrets in scopes, such as production, preview or ci, so
that an operation decrypts only what it uses. Each scope is encrypted to every
YubiKey in recipients.txt, and each decrypt needs a touch.

The setup steps are in profiles/dev-mac/bootstrap.md of the dotfiles checkout,
under "Set up the YubiKey secret store".

Verbs:
  init   Make the store, and add the inserted YubiKey to it (ykman must
         find exactly one). If the key has
         no age slot yet, make one (PIN once, touch always). Run it again
         with the backup YubiKey inserted.
  set    Ask for the value of each key, without echo, and replace the keys
         in the scope. The other keys stay. The file changes only after age
         succeeds.
  keys   Print the scopes of a project, or the keys of one scope. Never a
         value.
  get    Print one value, for a program that reads it through a pipe. It
         refuses to print to a terminal.
  run    Run the command with each key of the scope as an environment
         variable, for a tool that reads only its environment.
  rekey  Encrypt each scope again to the current recipients, after a YubiKey
         is added or lost.

Files:
  $SECRETS_HOME/identities.txt        the YubiKey identities (not secret)
  $SECRETS_HOME/recipients.txt        the recipients of every scope
  $SECRETS_HOME/<project>/recipients.txt
                                      replaces the shared recipients for the
                                      project, if it is there
  $SECRETS_HOME/<project>/<scope>.age the KEY=value lines of a scope

  A shell script can read one value without this command:
    source "$HOME/.local/lib/secrets/lib/store.sh"
    stored_secret <var> <project> <scope> <KEY> || <ask for it>

Environment:
  SECRETS_HOME  the store. Default: ${XDG_CONFIG_HOME:-~/.config}/secrets
EOF
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
"")
  usage >&2
  exit 1
  ;;
esac

verb="$1"
shift

# need_at_least <count> <args>... fails unless count arguments are given.
need_at_least() {
  local count="$1"
  shift
  [[ $# -ge "$count" ]] || die "$verb needs more arguments. Run secrets --help."
}

case "$verb" in
init)
  [[ $# -eq 0 ]] || die "init takes no arguments. Run secrets --help."
  init_store
  ;;
set)
  need_at_least 3 "$@"
  valid_name "$1"
  valid_name "$2"
  require_tool age
  set_keys "$@"
  ;;
keys)
  need_at_least 1 "$@"
  [[ $# -le 2 ]] || die "keys takes a project and a scope. Run secrets --help."
  valid_name "$1"
  [[ $# -lt 2 ]] || valid_name "$2"
  require_tool age
  list_keys "$@"
  ;;
get)
  [[ $# -eq 3 ]] || die "get takes a project, a scope and a key. Run secrets --help."
  valid_name "$1"
  valid_name "$2"
  require_tool age
  get_value "$@"
  ;;
run)
  need_at_least 4 "$@"
  [[ "$3" == "--" ]] || die "put -- before the command. Run secrets --help."
  valid_name "$1"
  valid_name "$2"
  require_tool age
  run_with "$1" "$2" "${@:4}"
  ;;
rekey)
  [[ $# -le 1 ]] || die "rekey takes one project at most. Run secrets --help."
  [[ $# -eq 0 ]] || valid_name "$1"
  require_tool age
  rekey_scopes "$@"
  ;;
*)
  die "unknown verb $verb. Run secrets --help."
  ;;
esac
