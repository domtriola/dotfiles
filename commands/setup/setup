#!/usr/bin/env bash
#
# Usage: setup [<pattern>] [--profile <name>] [--dry]
#
# Discovers and runs the setup steps for this machine's profile under ./profiles/.
#
# Every profile owns its setup steps, in profiles/<profile>/. There is no shared
# directory, because each machine installs what its use-case needs and
# duplication is accepted.
#
# Setup steps run in filename order. Use numeric prefixes (00_, 10_, 20_) to
# control ordering.
#
# Arguments:
#   <pattern>  A grep pattern. Only setup steps whose path matches <pattern>
#              run. If omitted, all setup steps run.
#   --profile  The use-case of this machine, named by a directory under
#              ./profiles/. Only needed the first time: the name is saved and
#              reused. $DOTFILES_PROFILE overrides both, without saving.
#   --dry      Print what would be executed without running anything. A dry run
#              never writes the profile file and never prompts.
#
# Examples:
#   setup                          # run every setup step of the profile
#   setup packages                 # run only setup steps matching "packages"
#   setup packages --dry           # preview which setup steps would run
#   setup --profile dev-mac --dry  # preview a profile, saving nothing

set -eo pipefail

# Lookup order: commands/README.md, "Finding the checkout".
dotfiles_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)"
[[ -d "$dotfiles_dir/profiles" ]] ||
  dotfiles_dir="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/checkout" 2>/dev/null || true)"
dotfiles_dir="${DOTFILES_DIR:-$dotfiles_dir}"
if [[ ! -d "$dotfiles_dir/profiles" ]]; then
  echo "setup: no dotfiles checkout found. Run sync-env from one, or set \$DOTFILES_DIR." >&2
  exit 1
fi
source "$dotfiles_dir/lib/platform.sh"
source "$dotfiles_dir/lib/profile.sh"
source "$dotfiles_dir/lib/style.sh"

filter=""
dry="0"
profile_arg=""

while [[ $# -gt 0 ]]; do
  case "$1" in
  --dry)
    dry="1"
    ;;
  --profile)
    shift
    profile_arg="${1:-}"
    if [[ -z "$profile_arg" ]]; then
      echo "setup: --profile needs a name (one of: $(profile_list))" >&2
      exit 1
    fi
    ;;
  --profile=*)
    profile_arg="${1#--profile=}"
    ;;
  -h | --help)
    awk 'NR > 2 && !/^#/ { exit } NR > 2 { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
    exit 0
    ;;
  -*)
    echo "setup: unknown argument '$1'" >&2
    exit 1
    ;;
  *)
    filter="$1"
    ;;
  esac
  shift
done

profile="$(resolve_profile "$profile_arg" "$dry")"

# The steps, and what became of each, for the summary at the end. The status
# of a step is one of the status words, and its time is in seconds.
step_names=()
step_words=()
step_times=()

# duration prints a number of seconds as "42s" or "3m05s".
duration() {
  if [[ $1 -lt 60 ]]; then
    printf '%ds' "$1"
  else
    printf '%dm%02ds' "$(($1 / 60))" "$(($1 % 60))"
  fi
}

# finish prints the summary: every step with its status and time, then the
# verdict. A step that did not run has no time.
finish() {
  local i word time count_ran=0 count_fail=0 count_not_run=0 count_skipped=0 count_info=0 worst summary

  echo
  for i in "${!step_names[@]}"; do
    word="${step_words[$i]}"
    time=""
    [[ "$word" == "ran" || "$word" == "FAIL" ]] && time="$(duration "${step_times[$i]}")"
    case "$word" in
    ran) count_ran=$((count_ran + 1)) ;;
    FAIL) count_fail=$((count_fail + 1)) ;;
    "not run") count_not_run=$((count_not_run + 1)) ;;
    skipped)
      count_skipped=$((count_skipped + 1))
      time="does not match '$filter'"
      ;;
    info)
      count_info=$((count_info + 1))
      time="would run"
      ;;
    esac
    status "$word" "${step_names[$i]}" "$time"
  done

  if [[ "$dry" == "1" ]]; then
    summary="setup: $count_info to run"
    worst="info"
  else
    summary="setup: $count_ran ran"
    worst="ok"
    if [[ $count_fail -gt 0 ]]; then
      summary+=", $count_fail FAIL, $count_not_run not run"
      worst="FAIL"
    fi
  fi
  [[ $count_skipped -gt 0 ]] && summary+=", $count_skipped skipped"
  [[ ${#step_names[@]} -gt 0 ]] || summary="setup: $profile has no setup steps"

  [[ ${#step_names[@]} -gt 0 ]] && echo
  verdict "$worst" "$summary"
}

heading "setup: $profile"
[[ "$dry" == "1" ]] && echo "Dry run: nothing changes"

cd "$dotfiles_dir"

scripts=()
dir="$dotfiles_dir/profiles/$profile"
if [[ -d "$dir" ]]; then
  while IFS= read -r line; do
    [[ -f "$line" && -x "$line" ]] && scripts+=("$line")
  done < <(find "$dir" -maxdepth 1 -mindepth 1 -type f | sort)
fi

# A step that fails stops the run, because a later step can depend on it. The
# steps after it are listed as not run, and setup exits with its status.
failed_status=0
for script in "${scripts[@]}"; do
  name="$(basename "$script")"
  step_names+=("$name")
  step_times+=(0)

  if [[ "$failed_status" -ne 0 ]]; then
    step_words+=("not run")
  elif [[ -n "$filter" ]] && ! grep -q -- "$filter" <<<"$script"; then
    step_words+=("skipped")
  elif [[ "$dry" == "1" ]]; then
    step_words+=("info")
  else
    # The step's own output passes through as it is: an indent would break the
    # progress bars of a package manager, and a capture would hide its prompts.
    section "$name"
    start=$SECONDS
    if "$script"; then
      step_words+=("ran")
      word="ran"
    else
      failed_status=$?
      step_words+=("FAIL")
      word="FAIL"
    fi
    step_times[${#step_times[@]} - 1]=$((SECONDS - start))
    status "$word" "$name" "$(duration $((SECONDS - start)))"
  fi
done

finish
exit "$failed_status"
