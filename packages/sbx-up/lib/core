#!/usr/bin/env bash
#
# Shared helpers: failure, and the paths every other verb reads.

die() {
  printf 'sbx-up: %s\n' "$1" >&2
  exit 1
}

# This package's own directory. Only the entry point is ever symlinked, so the
# path of this file needs no resolving.
sbx_up_pkg="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"

# The checkout that holds the kits and ./sync-skills.
sbx_up_dotfiles="${SBX_UP_DOTFILES:-$HOME/src/personal/dotfiles}"

# Values that belong to this machine rather than to a repository, such as the
# address of a private server. A kit reads them as ${{ kit.args.<name> }}.
sbx_up_kit_args_file="${SBX_KIT_ARGS_FILE:-$HOME/.config/sbx/kit.args}"

require_deps() {
  local dep
  for dep in sbx jq; do
    command -v "$dep" >/dev/null 2>&1 || die "$dep is not installed"
  done
}

# find_wait_bin sets wait_bin to an absolute path, because tmux starts the
# shell window without necessarily inheriting this shell's PATH.
find_wait_bin() {
  wait_bin="$sbx_up_pkg/libexec/sbx-wait"
  [[ -x "$wait_bin" ]] || die "$wait_bin is missing; run ./sync-env"
}
