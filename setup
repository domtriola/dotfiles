#!/usr/bin/env bash
#
# Usage: ./setup [<pattern>] [--profile <name>] [--dry]
#
# Discovers and executes the scripts for this machine's profile under ./setups/.
#
# Every profile owns its scripts: setups/<profile>/ (dev-mac, dev-linux,
# travel-qubes or sbx-linux). There is no shared directory, because each
# machine installs what its use-case needs and duplication is accepted.
#
# Scripts run in filename order. Use numeric prefixes (00_, 10_, 20_) to
# control ordering.
#
# Arguments:
#   <pattern>  A grep pattern. Only scripts whose path matches <pattern> are run.
#              If omitted, all scripts are run.
#   --profile  The use-case of this machine (dev-mac, dev-linux, travel-qubes,
#              sbx-linux). Only needed the first time: the name is saved and
#              reused. $DOTFILES_PROFILE overrides both, without saving.
#   --dry      Print what would be executed without running anything. A dry run
#              never writes the profile file and never prompts.
#
# Examples:
#   ./setup                          # run all platform-appropriate scripts
#   ./setup packages                 # run only scripts matching "packages"
#   ./setup packages --dry           # preview which scripts would run
#   ./setup --profile dev-mac --dry  # preview a profile, saving nothing

set -eo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
source "$script_dir/setups/lib/platform.sh"
source "$script_dir/setups/lib/profile.sh"

filter=""
dry="0"
profile_arg=""

while [[ $# -gt 0 ]]; do
  case "$1" in
  --dry)
    dry="1"
    ;;
  --profile)
    shift
    profile_arg="${1:-}"
    if [[ -z "$profile_arg" ]]; then
      echo "setup: --profile needs a name (one of: $(profile_list))" >&2
      exit 1
    fi
    ;;
  --profile=*)
    profile_arg="${1#--profile=}"
    ;;
  *)
    filter="$1"
    ;;
  esac
  shift
done

profile="$(resolve_profile "$profile_arg" "$dry")"

log() {
  if [[ $dry == "1" ]]; then
    echo "[DRY RUN]: $@"
  else
    echo "$@"
  fi
}

execute() {
  log "Execute $@"
  if [[ $dry == "1" ]]; then
    return
  fi

  "$@"
}

run_script() {
  local script="$1"
  if [[ -n "$filter" ]] && ! echo "$script" | grep -q "$filter"; then
    log "Skipping $script"
    return
  fi
  execute "$script"
}

run_dir() {
  local dir="$1"
  local -a scripts
  local script
  [[ -d "$dir" ]] || return 0
  log "--- $dir ---"

  mapfile -t scripts < <(find "$dir" -maxdepth 1 -mindepth 1 -type f | sort)
  for script in "${scripts[@]}"; do
    [[ -f "$script" && -x "$script" ]] || continue
    run_script "$script"
  done
}

log "$script_dir -- $filter"
log "profile: $profile"

cd "$script_dir"

run_dir "$script_dir/setups/$profile"

echo "----------------------------------------"
echo "All scripts executed"
