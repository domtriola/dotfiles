#!/usr/bin/env bash
#
# Key-only SSH, the firewall, and a machine that stays up.
#
# This runs first because it closes the door the machine is reached through.

set -eo pipefail

profile_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=lib/config.sh
source "$profile_dir/lib/config.sh"
ai_workstation_config_load

hardening_conf="/etc/ssh/sshd_config.d/01-hardening.conf"
authorized_keys="$HOME/.ssh/authorized_keys"

# ---------------------------------------------------------------------------
# Guard: refuse to disable password authentication with no key to fall back on.
# ---------------------------------------------------------------------------
if [[ ! -s "$authorized_keys" ]]; then
  cat >&2 <<EOF
05_hardening: $authorized_keys is missing or empty.

Disabling password authentication now would lock this machine out. Copy a key
from the client first, while password authentication still works:

  ssh-copy-id $USER@<this-host>

Then run this again.
EOF
  exit 1
fi

# ---------------------------------------------------------------------------
# SSH
# ---------------------------------------------------------------------------
echo "--- sshd ---"
echo "Writing $hardening_conf"
sudo tee "$hardening_conf" >/dev/null <<'EOF'
# Managed by dotfiles: profiles/ai-workstation/05_hardening
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
EOF
sudo chmod 644 "$hardening_conf"

# sshd -t rejects a broken file. The && keeps a bad config away from a restart.
sudo sshd -t && sudo systemctl restart ssh.service

# sshd -T prints the merged configuration. It is the only output that shows
# which file won, so it is what this checks rather than the file just written.
echo "Effective settings:"
effective="$(sudo sshd -T)"
for directive in passwordauthentication kbdinteractiveauthentication permitrootlogin; do
  value="$(awk -v d="$directive" 'tolower($1) == d { print $2; exit }' <<<"$effective")"
  printf '  %-32s %s\n' "$directive" "${value:-<unset>}"

  if [[ "$value" != "no" ]]; then
    cat >&2 <<EOF

05_hardening: $directive is "${value:-<unset>}", not "no".

Another file in /etc/ssh/sshd_config.d/ sets it first. Find it, and either
remove its setting or give this drop-in a lower number:

  grep -ri '$directive' /etc/ssh/sshd_config.d/ /etc/ssh/sshd_config
EOF
    exit 1
  fi
done

# ---------------------------------------------------------------------------
# Firewall
# ---------------------------------------------------------------------------
echo "--- ufw ---"

# `limit` is `allow` plus rate limiting. It matters here because this machine
# holds a global IPv6 address, so there is no NAT between it and the internet.
#
# Both commands are idempotent: ufw does not duplicate an existing rule, and
# enabling an active firewall is a no-op. --force skips the interactive
# "may disrupt existing ssh connections" prompt, which would hang an
# unattended run. The rule above is what makes skipping it safe.
#
# The default policy is set explicitly rather than assumed.
sudo ufw default deny incoming
sudo ufw default allow outgoing

# When SSH is limited to the overlay, 25_network owns the rule for port 22 and
# this one must stay away: adding it back would widen access on every run.
case "${AI_WORKSTATION_SSH_OVERLAY_ONLY:-no}" in
yes | true | 1)
  echo "SSH is limited to the overlay, so 22/tcp is left to 25_network."
  ;;
*)
  sudo ufw limit 22/tcp
  ;;
esac

sudo ufw --force enable
sudo ufw status verbose

if ! grep -q '^IPV6=yes' /etc/default/ufw; then
  echo "WARNING: IPV6 is not enabled in /etc/default/ufw." >&2
  echo "  This host has a global IPv6 address, so inbound IPv6 is unfiltered." >&2
fi

# ---------------------------------------------------------------------------
# Unattended reboots
# ---------------------------------------------------------------------------
#
# The root filesystem is encrypted and unlocked by a person at the console. A
# reboot that nobody asked for therefore leaves the machine down, with every
# agent stopped, until someone is at the keyboard. Security updates still
# install on their own. Only the restart is left to a person.
#
# apt reads the files in apt.conf.d in order, and a later value wins, so this
# file is numbered after 50unattended-upgrades. apt-config prints the merged
# result, which is what is checked.
echo "--- unattended-upgrades ---"
no_reboot_conf="/etc/apt/apt.conf.d/99-ai-workstation-no-reboot"
no_reboot_desired='// Managed by dotfiles: profiles/ai-workstation/05_hardening
Unattended-Upgrade::Automatic-Reboot "false";'

if [[ -f "$no_reboot_conf" ]] && [[ "$(cat "$no_reboot_conf")" == "$no_reboot_desired" ]]; then
  echo "$no_reboot_conf is already correct."
else
  echo "Writing $no_reboot_conf"
  printf '%s\n' "$no_reboot_desired" | sudo tee "$no_reboot_conf" >/dev/null
  sudo chmod 644 "$no_reboot_conf"
fi

reboot_value="$(apt-config dump 2>/dev/null |
  sed -n 's/^Unattended-Upgrade::Automatic-Reboot "\(.*\)";$/\1/p' | tail -1)"
echo "  Unattended-Upgrade::Automatic-Reboot: ${reboot_value:-<unset>}"
if [[ "$reboot_value" != "false" ]]; then
  echo "05_hardening: apt still reads Automatic-Reboot as '${reboot_value:-<unset>}'." >&2
  echo "  Find what sets it: grep -r Automatic-Reboot /etc/apt/apt.conf.d/" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Sleep
# ---------------------------------------------------------------------------
#
# A machine that suspends drops every SSH session and stops every agent. Ubuntu
# Server does not suspend by default, but a package can change that, so the
# targets are masked. A masked target cannot be started by anything.
echo "--- sleep ---"
sleep_targets=(sleep.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target)
for target in "${sleep_targets[@]}"; do
  if [[ "$(systemctl is-enabled "$target" 2>/dev/null)" == "masked" ]]; then
    echo "$target is already masked."
  else
    echo "Masking $target"
    sudo systemctl mask "$target" >/dev/null
  fi
done
