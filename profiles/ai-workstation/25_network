#!/usr/bin/env bash
#
# The overlay network, and the rules that depend on it.
#
# This machine is reached over an overlay rather than from the local network.
# The provider is NetBird, a WireGuard mesh: each peer gets an address on a
# private range, and a policy in the dashboard decides which peer may open which
# port on which other peer. The script is named for the job and not for the
# provider, because the provider can be replaced and the job cannot. What is
# provider-specific is the package repository and the `netbird` commands.
#
# This runs after 20_llama, because each step needs the one before it:
#
#   1. install the client
#   2. register this machine, which is what creates wt0
#   3. open the model port on wt0, and on wt0 alone
#   4. put a proxy on the overlay address in front of the model server
#
# Step 3 is needed because 05_hardening denies inbound traffic by default, and
# overlay traffic arrives as inbound traffic on wt0. Without it the model
# answers on this machine and stays unreachable from the client, which is a
# confusing fault to find.
#
# Step 4 exists because llama-swap listens on one address, and that address is
# loopback, where the sandboxes on this machine reach it. The proxy listens on
# the overlay address alone, so a wrong or deleted firewall rule still exposes
# nothing on the local network or on the global IPv6 address. The API key is
# the third control, and the only one that does not depend on where a request
# came from.
#
# The setup key is a secret and is not held in this repository. It is read from
# $NETBIRD_SETUP_KEY and written to a file at mode 600. It is never passed as an
# argument, because arguments are readable by every local user through /proc and
# a setup key registers new machines.
#
# Settings, from /etc/ai-workstation/config.env or the environment:
#
#   $AI_WORKSTATION_OVERLAY_HOSTNAME    the name this peer takes in the dashboard.
#                                  Empty means the system hostname.
#   $AI_WORKSTATION_OVERLAY_UP_TIMEOUT  seconds to wait for the client to connect.
#   $AI_WORKSTATION_SERVE_OVERLAY       yes serves the model on the overlay
#                                  address as well as on loopback.
#   $AI_WORKSTATION_SSH_OVERLAY_ONLY    yes narrows SSH to the overlay. Read the
#                                  warning at that section first.
#
# Two values are deliberately not settings, because they are secrets or
# one-offs and do not belong in a file that every tool reads:
#
#   $NETBIRD_SETUP_KEY          registers this machine. Without it, an
#                               unregistered machine is reported and skipped.
#   $NETBIRD_REPO_KEY_SHA256    the expected digest of the repository signing
#                               key. Unset means the key is trusted on first
#                               use, over TLS, and its digest is printed.

set -eo pipefail

profile_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=lib/config.sh
source "$profile_dir/lib/config.sh"
ai_workstation_config_load

iface="wt0" # the default WireGuard interface of the NetBird client

keyring="/usr/share/keyrings/netbird-archive-keyring.asc"
sources="/etc/apt/sources.list.d/netbird.list"
key_url="https://pkgs.netbird.io/debian/public.key"
repo_url="https://pkgs.netbird.io/debian"

proxy_socket="/etc/systemd/system/llama-swap-overlay.socket"
proxy_service="/etc/systemd/system/llama-swap-overlay.service"
socket_proxyd="/usr/lib/systemd/systemd-socket-proxyd"

# ---------------------------------------------------------------------------
# Guards
# ---------------------------------------------------------------------------
if ! command -v apt-get >/dev/null 2>&1; then
  echo "25_network: no apt-get. This profile targets Ubuntu Server." >&2
  exit 1
fi

# The client reports its state as JSON, and every decision below reads that
# rather than matching English in the human summary, which changes between
# releases.
if ! command -v jq >/dev/null 2>&1; then
  echo "25_network: jq is missing. Run 10_packages first." >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# The client
# ---------------------------------------------------------------------------
if command -v netbird >/dev/null 2>&1; then
  echo "netbird is already installed: $(netbird version 2>/dev/null || echo 'version unknown')"
else
  echo "--- installing the netbird client ---"

  # The key is kept ASCII-armoured, and apt is pointed at the .asc file
  # directly. apt accepts an armoured key in signed-by, so nothing has to be
  # converted, and the file stays readable text that can be compared between
  # machines. The vendor's own installer pipes it through `gpg --dearmor`,
  # which produces a binary blob and needs gnupg present before apt can run.
  tmp_key="$(mktemp)"
  curl -fsSL --retry 3 --proto '=https' --tlsv1.2 -o "$tmp_key" "$key_url"

  key_sha="$(sha256sum "$tmp_key" | cut -d' ' -f1)"
  if [[ -n "${NETBIRD_REPO_KEY_SHA256:-}" ]]; then
    if [[ "$key_sha" != "$NETBIRD_REPO_KEY_SHA256" ]]; then
      rm -f "$tmp_key"
      echo "25_network: the repository key does not match its pinned digest." >&2
      echo "  expected ${NETBIRD_REPO_KEY_SHA256}" >&2
      echo "  got      ${key_sha}" >&2
      echo "Nothing was installed. Find out why it changed before setting the" >&2
      echo "pin to the value that was downloaded." >&2
      exit 1
    fi
    echo "  repository key digest ok"
  else
    # Trust on first use, over TLS. The digest is printed so the same key can
    # be checked against another machine, or pinned with
    # $NETBIRD_REPO_KEY_SHA256 on the next run.
    echo "  repository key sha256: $key_sha"
  fi

  sudo install -m 644 "$tmp_key" "$keyring"
  rm -f "$tmp_key"

  tmp_list="$(mktemp)"
  printf '# Managed by dotfiles: profiles/ai-workstation/25_network\ndeb [signed-by=%s] %s stable main\n' \
    "$keyring" "$repo_url" >"$tmp_list"
  sudo install -m 644 "$tmp_list" "$sources"
  rm -f "$tmp_list"

  sudo apt-get update -qq
  # netbird-ui is deliberately not installed. This machine is headless.
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends netbird
fi

# ---------------------------------------------------------------------------
# The daemon
# ---------------------------------------------------------------------------
#
# The package installs and starts the service from its own post-install script,
# so this normally finds the work done. It runs anyway, because a client that is
# present but not running otherwise looks like a client that is not installed.
if ! systemctl cat netbird.service >/dev/null 2>&1; then
  echo "Installing the netbird service unit."
  sudo netbird service install
fi

if ! systemctl is-enabled --quiet netbird 2>/dev/null; then
  sudo systemctl enable netbird >/dev/null
fi

if ! systemctl is-active --quiet netbird; then
  echo "Starting the netbird service."
  sudo systemctl start netbird
fi

# ---------------------------------------------------------------------------
# Registration
# ---------------------------------------------------------------------------
#
# Registered is a property of the machine and not of this repository, so it is
# read from the client rather than assumed from a file this script wrote.
overlay_connected() {
  local json
  json="$(netbird status --json 2>/dev/null)" || return 1
  [[ "$(jq -r '.management.connected // false' <<<"$json")" == "true" ]]
}

if overlay_connected; then
  echo "Already registered: the management service is connected."
elif [[ -n "${NETBIRD_SETUP_KEY:-}" ]]; then
  echo "--- registering this machine ---"

  # mktemp creates at mode 600, so the key is never world-readable, and the
  # trap removes it even when netbird fails or the run is interrupted.
  key_file="$(mktemp)"
  trap 'rm -f "$key_file"' EXIT
  printf '%s' "$NETBIRD_SETUP_KEY" >"$key_file"

  up_args=(--setup-key-file "$key_file")
  if [[ -n "${AI_WORKSTATION_OVERLAY_HOSTNAME:-}" ]]; then
    up_args+=(--hostname "$AI_WORKSTATION_OVERLAY_HOSTNAME")
  fi

  # `netbird up` is slow and silent, and the two have different causes.
  #
  # Slow: registration happens early, and the command then waits for the engine
  # to finish connecting. Measured at several minutes on a first registration.
  #
  # Silent: the wait is a status request the daemon answers with a loop, ending
  # only when the engine connects, gives up, or the caller goes away. The client
  # passes no deadline with it, so nothing here can be read as progress, and a
  # daemon that never connects waits for ever.
  #
  # So the wait is reported rather than shortened, and the bound is generous
  # enough not to cut off a registration that is working. It exists to turn a
  # stuck daemon into a message, not to decide how long a real one may take.
  #
  # `timeout` goes inside sudo, not outside it: outside, it would kill sudo and
  # leave netbird running.
  up_timeout="${AI_WORKSTATION_OVERLAY_UP_TIMEOUT:-900}"

  cat <<EOF
Running netbird up. This takes minutes rather than seconds on a first
registration, and the command prints nothing of its own while it waits. Watch
it from another terminal with:

  journalctl -u netbird -f
EOF

  # The progress line is this script's own. Without it a wait of several
  # minutes cannot be told apart from a stopped script, which is what it was
  # first reported as.
  while sleep 20; do
    echo "  waiting. daemon status: $(timeout 10 netbird status --json 2>/dev/null |
      jq -r '.daemonStatus // "unreachable"')"
  done &
  ticker=$!
  trap 'rm -f "$key_file"; kill "$ticker" 2>/dev/null || true' EXIT

  up_status=0
  sudo timeout "$up_timeout" netbird up "${up_args[@]}" || up_status=$?

  # Both need `|| true` under `set -e`. `kill` fails when the job has already
  # gone, and `wait` reports the signal that stopped it (143), so either one
  # would end the run here on its way to reporting success.
  kill "$ticker" 2>/dev/null || true
  wait "$ticker" 2>/dev/null || true
  rm -f "$key_file"
  trap - EXIT

  if [[ $up_status -eq 124 ]]; then
    cat >&2 <<EOF

25_network: netbird up did not finish in ${up_timeout} seconds.

Registration itself may well have worked, because it happens before the wait
that timed out. Check whether the peer is in the dashboard, then read what the
daemon is doing:

  netbird status --detail
  journalctl -u netbird -n 50

The usual cause is an engine that cannot reach the management or relay service
and keeps retrying. Run this script again once the daemon reports the
management service as connected: it skips registration then, and needs no key.
Raise \$AI_WORKSTATION_OVERLAY_UP_TIMEOUT if this machine is slower than the bound.
EOF
    exit 1
  elif [[ $up_status -ne 0 ]]; then
    echo "25_network: netbird up failed with exit status $up_status." >&2
    exit "$up_status"
  fi
else
  cat <<EOF

Not registered, and \$NETBIRD_SETUP_KEY is empty. Skipping.

The key is a secret, so it is not held in this repository. Take a one-off key
from the dashboard, one that auto-assigns the ai-workstation group, then:

  NETBIRD_SETUP_KEY='<key>' setup 25_network

Everything after this point needs the $iface interface, which does not exist
until the machine is registered. Nothing here has been changed.
EOF
  exit 0
fi

# ---------------------------------------------------------------------------
# The overlay address
# ---------------------------------------------------------------------------
#
# Read from the interface and not from the client's own report, because the
# address that can be bound to is the one the kernel has. Registration returns
# before the interface is fully up, so this waits rather than reading once.
#
# The wait says so. A loop that prints nothing for half a minute reads as a
# stopped script, which is the same thing this step already looks like.
overlay_ip=""
for attempt in $(seq 1 30); do
  overlay_ip="$(ip -4 -br addr show "$iface" 2>/dev/null | awk '{print $3}' | cut -d/ -f1)"
  [[ -n "$overlay_ip" ]] && break
  [[ "$attempt" -eq 1 ]] && echo "Waiting up to 30 seconds for $iface to get an address."
  sleep 1
done

if [[ -z "$overlay_ip" ]]; then
  cat >&2 <<EOF
25_network: $iface has no IPv4 address after 30 seconds.

The client reports the management service as connected, so this is the peer
itself failing to come up. Read the state and the log:

  netbird status --detail
  journalctl -u netbird -n 50
EOF
  exit 1
fi

echo "Overlay address: $overlay_ip on $iface"

# ---------------------------------------------------------------------------
# The model port
# ---------------------------------------------------------------------------
#
# The port is read from the installed unit, so that this cannot open a port the
# server is not on. $LLAMA_SWAP_LISTEN is the same variable 20_llama takes, and
# 8080 is the same default.
unit_listen="$(systemctl show -p Environment --value llama-swap 2>/dev/null |
  tr ' ' '\n' | sed -n 's/^LLAMA_SWAP_LISTEN=//p' | tail -1)"
listen="${unit_listen:-${LLAMA_SWAP_LISTEN:-127.0.0.1:8080}}"
model_port="${listen##*:}"

if [[ ! "$model_port" =~ ^[0-9]+$ ]]; then
  echo "25_network: could not read a port from '$listen'." >&2
  exit 1
fi

echo "--- firewall ---"

# `in on $iface` is what limits this to overlay peers. The same rule without an
# interface would open the port to the local network and to the internet, which
# is what this whole step exists to avoid. ufw does not duplicate a rule that
# already exists, so a rerun prints "Skipping" and changes nothing.
case "${AI_WORKSTATION_SERVE_OVERLAY:-yes}" in
no | false | 0) ;;
*) sudo ufw allow in on "$iface" to any port "$model_port" proto tcp ;;
esac

# ---------------------------------------------------------------------------
# Serve the model on the overlay
# ---------------------------------------------------------------------------
#
# systemd-socket-proxyd forwards each connection to llama-swap on loopback. It
# is part of systemd, so nothing is installed for it, and the socket unit lets
# systemd hold the listening address.
#
# FreeBind lets the socket bind to the overlay address before wt0 has it. wt0
# does not exist early in a boot, and without FreeBind the socket would fail
# then and stay failed. With it, the socket binds at once and starts receiving
# traffic when the address arrives.
#
# The address is written into the unit. If the overlay ever gives this peer a
# different address, run this step again.
case "${AI_WORKSTATION_SERVE_OVERLAY:-yes}" in
yes | true | 1)
  serve_overlay=1
  ;;
no | false | 0)
  serve_overlay=0
  ;;
*)
  echo "25_network: \$AI_WORKSTATION_SERVE_OVERLAY is '${AI_WORKSTATION_SERVE_OVERLAY}'. Use yes or no." >&2
  exit 1
  ;;
esac

if [[ "$serve_overlay" -eq 0 ]]; then
  echo "Not serving the model on the overlay: AI_WORKSTATION_SERVE_OVERLAY is no."
  if [[ -f "$proxy_socket" ]]; then
    echo "Removing the overlay proxy."
    sudo systemctl disable --now llama-swap-overlay.socket llama-swap-overlay.service 2>/dev/null || true
    sudo rm -f "$proxy_socket" "$proxy_service"
    sudo systemctl daemon-reload
  fi
  if sudo ufw status | grep -qE "^${model_port}/tcp on ${iface} +ALLOW"; then
    sudo ufw delete allow in on "$iface" to any port "$model_port" proto tcp
  fi
elif [[ ! -x "$socket_proxyd" ]]; then
  echo "25_network: $socket_proxyd is missing, so the overlay proxy cannot run." >&2
  exit 1
else
  # The upstream is read from the installed unit, the same way the port was,
  # so the proxy cannot point at an address llama-swap is not on.
  upstream_host="${listen%:*}"
  [[ -z "$upstream_host" || "$upstream_host" == "0.0.0.0" ]] && upstream_host="127.0.0.1"

  tmp_socket="$(mktemp)"
  cat >"$tmp_socket" <<UNIT
# Managed by dotfiles: profiles/ai-workstation/25_network
[Unit]
Description=Model server on the overlay address

[Socket]
ListenStream=$overlay_ip:$model_port
FreeBind=true

[Install]
WantedBy=sockets.target
UNIT

  tmp_service="$(mktemp)"
  cat >"$tmp_service" <<UNIT
# Managed by dotfiles: profiles/ai-workstation/25_network
[Unit]
Description=Model server on the overlay address, forwarded to loopback
Requires=llama-swap-overlay.socket
After=llama-swap-overlay.socket llama-swap.service

[Service]
ExecStart=$socket_proxyd $upstream_host:$model_port
# The proxy forwards bytes and needs nothing else.
DynamicUser=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
UNIT

  proxy_changed=0
  for pair in "$tmp_socket:$proxy_socket" "$tmp_service:$proxy_service"; do
    tmp_file="${pair%%:*}"
    dest="${pair#*:}"
    if [[ -f "$dest" ]] && sudo cmp -s "$tmp_file" "$dest"; then
      echo "$dest is already correct."
    else
      echo "Writing $dest"
      sudo install -m 644 "$tmp_file" "$dest"
      proxy_changed=1
    fi
    rm -f "$tmp_file"
  done

  if [[ "$proxy_changed" -eq 1 ]]; then
    sudo systemctl daemon-reload
    # The socket holds the address, so it is the unit that has to restart to
    # take a new one. The proxy starts on the first connection, and is stopped
    # here so that it picks up a changed upstream.
    sudo systemctl stop llama-swap-overlay.service 2>/dev/null || true
    sudo systemctl restart llama-swap-overlay.socket
  fi
  sudo systemctl enable --now llama-swap-overlay.socket >/dev/null
  echo "Model server on the overlay: $overlay_ip:$model_port -> $upstream_host:$model_port"
fi

# ---------------------------------------------------------------------------
# SSH over the overlay, if asked for
# ---------------------------------------------------------------------------
#
# Off unless $AI_WORKSTATION_SSH_OVERLAY_ONLY says otherwise, because it removes the
# general rule for port 22 and therefore the only way in that does not depend on
# the overlay. If the overlay then stops working, the machine needs a keyboard
# and a monitor. That risk stacks with the encrypted root, which already needs a
# person at the console for a reboot.
#
# 05_hardening reads the firewall to see whether this was applied, so a later
# setup does not put the general rule back.
case "${AI_WORKSTATION_SSH_OVERLAY_ONLY:-}" in
yes | true | 1)
  ssh_overlay_only=1
  ;;
"" | no | false | 0)
  ssh_overlay_only=0
  echo "SSH is unchanged, from AI_WORKSTATION_SSH_OVERLAY_ONLY."
  ;;
*)
  echo "25_network: \$AI_WORKSTATION_SSH_OVERLAY_ONLY is '${AI_WORKSTATION_SSH_OVERLAY_ONLY}'. Use yes or no." >&2
  exit 1
  ;;
esac

if [[ "$ssh_overlay_only" -eq 1 ]]; then
  echo "--- ssh over the overlay ---"

  # A connected peer is the proof that some other machine can reach this one
  # over the overlay. Removing the general rule with no peer connected is how
  # this step would lock the machine out, so it is refused rather than warned
  # about.
  peers_connected="$(netbird status --json 2>/dev/null | jq -r '.peers.connected // 0')"

  if [[ ! "$peers_connected" =~ ^[0-9]+$ ]] || [[ "$peers_connected" -lt 1 ]]; then
    cat >&2 <<EOF
25_network: no peer is connected, so SSH was left as it is.

Narrowing SSH now would remove the general rule for port 22 while nothing is
proven to reach this machine over $iface. Bring the client peer up, check it
here, and run this again:

  netbird status --detail
EOF
    exit 1
  fi

  echo "Peers connected: $peers_connected"
  sudo ufw allow in on "$iface" to any port 22 proto tcp

  # Deleted only after the overlay rule is in place, so there is never a moment
  # with no rule for port 22 at all. `delete limit` has to name the rule the
  # way 05_hardening added it.
  if sudo ufw status | grep -qE '^22/tcp +LIMIT'; then
    echo "Removing the general rule for 22/tcp."
    sudo ufw delete limit 22/tcp
  else
    echo "There is no general rule for 22/tcp to remove."
  fi

  cat <<EOF

SSH now answers on $iface only.

Test it from a peer BEFORE closing this session. A terminal that is already
open keeps working, because the rule applies to new connections.
EOF
fi

# ---------------------------------------------------------------------------
# Result
# ---------------------------------------------------------------------------
echo
echo "--- overlay ---"
netbird status --json 2>/dev/null | jq -r '
  "  address:    " + .netbirdIp,
  "  fqdn:       " + .fqdn,
  "  management: " + (if .management.connected then "connected" else "disconnected" end),
  "  peers:      " + (.peers.connected | tostring) + " of " + (.peers.total | tostring) + " connected"
' || netbird status

cat <<EOF

The model API is at http://$overlay_ip:$model_port/v1 for peers the dashboard
policy allows. It needs the key, which only root can read:

  sudo sed -n 's/^LLAMA_SWAP_API_KEY=//p' /etc/llama-swap/api-key.env

The policy is not set from here. In the dashboard, delete the "Default" policy,
which lets every peer reach every other peer on any protocol and overrides any
stricter rule. Replace it with one policy: source the client group, destination
the ai-workstation group, TCP, ports 22 and $model_port, one-way. Without port
22, ssh to the overlay address hangs with no error.
EOF
