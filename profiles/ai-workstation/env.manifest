# Environment files for the ai-workstation profile.
#
# Directive reference: ../../commands/sync-env/sync-env
#
# The host is kept small: shell, editor, tmux, and what starts sandboxes.
# Language toolchains and agent configuration live in the sandboxes, where the
# dotfiles and agent-skills kits put them.

group Editor
dir .config/nvim $HOME/.config/nvim
# Used by nvim-lint:
file .markdownlint.json $HOME

group Commands
command setup $HOME/.local
command sync-env $HOME/.local
command doctor $HOME/.local
command pull-nvim $HOME/.local
# sbx-up runs sync-skills before every start, so both are needed.
command sbx-up $HOME/.local
command sync-skills $HOME/.local

group Binaries
file .local/bin/sbx-pull $HOME/.local/bin
file .local/bin/tmux-sessionizer $HOME/.local/bin
file .local/bin/troot $HOME/.local/bin

group Shell configuration
file .bash_profile $HOME
file .bashrc $HOME
dir .bashrc.d $HOME/.bashrc.d

group Tmux configuration
file .tmux.conf $HOME
file .ready-tmux $HOME
file .local/bin/init-tmux $HOME/.local/bin
file .local/bin/ready-tmux $HOME/.local/bin
dir troot $HOME/troot
