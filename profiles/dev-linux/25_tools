#!/usr/bin/env bash
#
# Packages installed from their own installers rather than from dnf.
# Runs after 15_languages, because the pi agent needs npm.

set -x

# Terminal Prompt
curl -sS https://starship.rs/install.sh | sh

# Ollama for local models
curl -fsSL https://ollama.com/install.sh | sh

# Pi agent harness
npm install -g --ignore-scripts @earendil-works/pi-coding-agent
