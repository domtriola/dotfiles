# Dotfiles and commands for the agent-server profile: only what runs agents in
# sandboxes. No nvim, and no ready-tmux or .ready-tmux, because the operator
# does not edit code on this machine, and a repository that agents push to
# must not run code in a new tmux session.
#
# Directive reference: ../../commands/sync-env/sync-env

group Binaries
file .local/bin/tmux-sessionizer $HOME/.local/bin
file .local/bin/troot $HOME/.local/bin
file .local/bin/git-prune-branches $HOME/.local/bin

group Commands
command setup $HOME/.local
command sync-env $HOME/.local
command doctor $HOME/.local
command sync-skills $HOME/.local
command sbx-up $HOME/.local
command sbx-shell $HOME/.local
command sbx-token $HOME/.local
command sbx-policy $HOME/.local

group Shell configuration
file .bash_profile $HOME
file .bashrc $HOME
dir .bashrc.d $HOME/.bashrc.d
# After the dir line, which replaces ~/.bashrc.d.
file agent-server/.bashrc.d/sbx-token.bashrc $HOME/.bashrc.d

group Tmux configuration
file .tmux.conf $HOME
dir troot $HOME/troot
