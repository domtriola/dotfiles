#!/usr/bin/env bash
#
# pnpm, for global tools that the operator runs on the box, such as sfw.
# Never `pnpm install` in a box clone: that runs code that agents wrote,
# outside a sandbox (agent-server-T24).
#
# Node comes from apt in 10_packages. Its corepack is too old to run pnpm 11
# or later, so get-pnpm installs the standalone pnpm into PNPM_HOME, as on
# dev-mac. ~/.bashrc.d/pnpm.bashrc puts it on PATH, and
# ~/.config/pnpm/config.yaml holds the 7-day minimum release age.

set -eo pipefail

pnpm_major=12

export PNPM_HOME="$HOME/.local/share/pnpm"

if [[ -x "$PNPM_HOME/bin/pnpm" ]]; then
  echo "pnpm $("$PNPM_HOME/bin/pnpm" --version) is already installed. Run pnpm self-update to upgrade it."
  exit 0
fi

# get-pnpm hands over to `pnpm setup`, which edits the rc file of $SHELL.
# ~/.bashrc is a dotfile, so SHELL is unset and pnpm.bashrc sets PATH instead.
# The home directory has no package.json that could pin another version.
cd "$HOME"
env -u SHELL npx --yes get-pnpm "$pnpm_major"
