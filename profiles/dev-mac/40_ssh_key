#!/usr/bin/env bash
#
# Creates an SSH key in the Secure Enclave, and signs Git commits with it.
#
# The private key never leaves the Secure Enclave, and every use needs Touch
# ID. macOS supplies the provider (/usr/lib/ssh-keychain.dylib), so no agent
# socket is used.
#
# The key file in ~/.ssh is a reference to the key, not the private key.
# ~/.ssh/config names it with IdentityFile, because ssh stops trying its
# default key files as soon as any IdentityFile is set. IdentitiesOnly stops
# ssh from also offering keys from an agent.
#
# Needs Touch ID, so this script cannot run unattended the first time.
#
# SSH_KEY_PROT=none makes a new key without Touch ID, for when Touch ID is not
# reliable. Any process that runs as you can then use the key without a
# prompt, so doctor reports it as a failure. It only applies when the key is
# made. An existing key with bio or none protection is kept.
#
# Usage: SSH_KEY_PROT=none setup 40_ssh_key

set -eox pipefail

profile_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
root_dir="$(cd "$profile_dir/../.." >/dev/null 2>&1 && pwd)"
# shellcheck source=../../lib/prompt.sh
source "$root_dir/lib/prompt.sh"

key_label="ssh"
key_file="$HOME/.ssh/id_ecdsa_sk"
ssh_config="$HOME/.ssh/config"
allowed_signers="$HOME/.ssh/allowed_signers"
provider="/usr/lib/ssh-keychain.dylib"
new_prot="${SSH_KEY_PROT:-bio}"

if [[ "$new_prot" != "bio" && "$new_prot" != "none" ]]; then
  echo "SSH_KEY_PROT must be bio or none, not \"$new_prot\"." >&2
  exit 1
fi

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

# Key
# #######################################################

# The protection of each identity with this label, one per line. Columns:
# Key Type, Public Key Hash, Prot, Label.
key_prot="$(sc_auth list-ctk-identities | awk -v label="$key_label" '$4 == label { print $3 }')"

# OpenSSH supports p-256-ne only. It does not support p-384-ne.
if [[ -z "$key_prot" ]]; then
  if [[ "$new_prot" == "bio" ]]; then
    echo "NOTE: Use Touch ID if asked. This creates the key in the Secure Enclave."
  fi
  sc_auth create-ctk-identity -l "$key_label" -k p-256-ne -t "$new_prot"
elif [[ "$key_prot" == "none" ]]; then
  echo "WARNING: The \"$key_label\" Secure Enclave key has no Touch ID protection." >&2
elif [[ "$key_prot" != "bio" ]]; then
  echo "The \"$key_label\" Secure Enclave identity is not a single key with bio or none protection:" >&2
  sc_auth list-ctk-identities >&2
  echo "Delete it with sc_auth delete-ctk-identity -h <hash>, then run this script again." >&2
  exit 1
fi

# ssh-keygen -K writes every resident key to the current directory. Newer
# macOS names each file after its label (id_ecdsa_sk_rk_ssh). Older macOS
# writes every key to id_ecdsa_sk_rk, and each key overwrites the previous
# one. A temporary directory keeps that output out of ~/.ssh until the result
# is known.
if [[ ! -f "$key_file" ]]; then
  echo "NOTE: Use Touch ID if asked. Then, at \"Enter PIN for authenticator\", press Enter."
  echo "      The key has no PIN. ssh-keygen asks for one because it treats the"
  echo "      Secure Enclave as a FIDO security key."
  tmp_dir="$(mktemp -d)"
  (cd "$tmp_dir" && /usr/bin/ssh-keygen -w "$provider" -K -N "")
  downloaded="$tmp_dir/id_ecdsa_sk_rk_$key_label"
  [[ -f "$downloaded" ]] || downloaded="$tmp_dir/id_ecdsa_sk_rk"
  if [[ ! -f "$downloaded" ]]; then
    echo "ssh-keygen did not write the \"$key_label\" key. It wrote:" >&2
    ls "$tmp_dir" >&2
    exit 1
  fi
  mv "$downloaded" "$key_file"
  mv "$downloaded.pub" "$key_file.pub"
  rm -rf "$tmp_dir"
  chmod 600 "$key_file"
fi

# SSH config
# #######################################################

# SecurityKeyProvider is set here as well as in .zshrc, so that apps that do
# not read the shell rc files (GUI Git clients) can also use the key.
new_config="$(mktemp)"
cat >"$new_config" <<EOF
Host *
  SecurityKeyProvider $provider
  IdentityFile ~/.ssh/id_ecdsa_sk
  IdentitiesOnly yes
EOF

if [[ ! -f "$ssh_config" ]]; then
  mv "$new_config" "$ssh_config"
elif cmp -s "$new_config" "$ssh_config"; then
  rm "$new_config"
elif confirm "Replace $ssh_config? The old file is kept as $ssh_config.bak."; then
  cp "$ssh_config" "$ssh_config.bak"
  mv "$new_config" "$ssh_config"
else
  rm "$new_config"
  echo "Kept $ssh_config. ssh may not offer the Secure Enclave key."
fi
chmod 600 "$ssh_config"

# Git commit signing
# #######################################################

git config --global gpg.format ssh
git config --global user.signingkey "$key_file"
git config --global gpg.ssh.program "$HOME/.local/bin/ssh-keygen-enclave"
git config --global commit.gpgsign true

# For `git log --show-signature`. Verification needs only the public key.
email="$(git config --global user.email || true)"
if [[ -z "$email" ]]; then
  echo "Set user.email with git config --global, then run this script again." >&2
  exit 1
fi
echo "$email $(cat "$key_file.pub")" >"$allowed_signers"
git config --global gpg.ssh.allowedSignersFile "$allowed_signers"
