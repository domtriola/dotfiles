# Environment files for the dev-mac profile.
#
# Directive reference: ../../commands/sync-env/sync-env

group General directories
subdirs .config $HOME/.config

group Binaries
file .local/bin/init-tmux $HOME/.local/bin
file .local/bin/ready-tmux $HOME/.local/bin
file .local/bin/tmux-sessionizer $HOME/.local/bin
file .local/bin/troot $HOME/.local/bin
file .local/bin/sbx-pull $HOME/.local/bin
file .local/bin/ssh-keygen-enclave $HOME/.local/bin

group Commands
command setup $HOME/.local
command sync-env $HOME/.local
command doctor $HOME/.local
command sync-skills $HOME/.local
command pull-nvim $HOME/.local
command sbx-up $HOME/.local
command sbx-token $HOME/.local

group Shell configuration
file .zshrc $HOME
file .zprofile $HOME

group Tmux configuration
file .tmux.conf $HOME
file .ready-tmux $HOME
dir troot $HOME/troot

group AWS configuration
file .aws/config $HOME/.aws

group Hammerspoon configuration
subdirs .hammerspoon $HOME/.hammerspoon
file .hammerspoon/init.lua $HOME/.hammerspoon

group Claude settings
file .claude/CLAUDE.md $HOME/.claude
file .claude/settings.json $HOME/.claude
file .claude/statusline.sh $HOME/.claude

group Agent skills
# dir replaces the destination, so a skill dropped from env/.agents/skills
# really disappears here too. The untracked scratch copies land afterwards, so
# a local skill shadows a tracked one of the same name.
dir .agents/skills $HOME/.claude/skills
dir .agents/skills $HOME/.agents/skills
subdirs .agents/skills-local $HOME/.claude/skills
subdirs .agents/skills-local $HOME/.agents/skills

group pnpm configuration
# pnpm reads its global config from here on macOS, not from ~/.config, unless
# XDG_CONFIG_HOME is set:
file .config/pnpm/config.yaml $HOME/Library/Preferences/pnpm

group Misc configs
# Used by nvim-lint:
file .markdownlint.json $HOME
