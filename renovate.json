{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "description": "Versions pinned in kit specs, after a '# renovate:' comment",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)spec\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
