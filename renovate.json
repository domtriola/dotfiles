{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "description": "Versions pinned in kit specs, after a '# renovate:' comment",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)spec\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "description": "Kits that a kit spec extends, pinned by the digest of the kit's latest tag",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)spec\\.yaml$/"],
      "matchStrings": [
        "extends: \"oci://(?<depName>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "currentValueTemplate": "latest"
    },
    {
      "description": "The nvm install script URL in the language setup steps",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)15_languages$/"],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/(?<depName>nvm-sh/nvm)/(?<currentValue>v[0-9.]+)/install\\.sh"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
