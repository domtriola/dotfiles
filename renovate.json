{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "description": "Versions pinned in the kits, after a '# renovate:' comment: a shell assignment in a descriptor, or an ARG in a recipe",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)sbx/kits/.+\\.(yaml|dockerfile)$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:ARG\\s+)?\\w+=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "description": "Docker's v3 workloads that sbx-up runs, pinned by version tag and digest. Renovate moves both together",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)commands/sbx-up/lib/config$/"],
      "matchStrings": [
        "(?<depName>docker\\.io/docker/sbx-kit-[a-z0-9-]+):(?<currentValue>[0-9][^@\\s\"]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "The nvm install script URL in the language setup steps",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)15_languages$/"],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/(?<depName>nvm-sh/nvm)/(?<currentValue>v[0-9.]+)/install\\.sh"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
