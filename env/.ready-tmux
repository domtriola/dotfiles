#!/usr/bin/env bash

# CLI:
tmux rename-window cli

# Nvim:
tmux neww -n dev
tmux send-keys "nvim" C-m

# AI:
tmux neww -n ai

#NOTE: Never store secrets locally in the project.
# Agents in the sandbox have full access to the project contents
# and run with full privileges. Don't rely on custom agent settings
# to secure secrets.
tmux send-keys "my-claude"

# Server:
# tmux neww -n server

# Tests:
# tmux neww -n tests

tmux select-window -t cli
