#!/usr/bin/env bash
#
# ssh-keygen for Git commit signing with a Secure Enclave key.
#
# Apple's ssh-keygen is used by path, because Homebrew's OpenSSH cannot load
# the Secure Enclave provider. The provider is set here, so that Git clients
# that do not read the shell rc files can also sign.
#
# The key is used through the provider, not an agent. ssh-keygen -Y sign tries
# the agent at SSH_AUTH_SOCK first, and an agent that does not answer makes
# every commit hang.

set -euo pipefail

unset SSH_AUTH_SOCK
export SSH_SK_PROVIDER=/usr/lib/ssh-keychain.dylib
exec /usr/bin/ssh-keygen "$@"
