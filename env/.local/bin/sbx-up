#!/usr/bin/env bash
#
# Usage: sbx-up
#
# Starts a Docker sandbox for the current project in a new tmux window, named
# after the project and the checked-out branch. Any existing sandbox of that
# name is removed first, so the sandbox always starts from fresh state.
#
# When run inside tmux, a second window opens a plain shell into the same
# sandbox via `sbx exec -it` for editing or running git commands without going
# through the agent. It waits for the sandbox to be configured first; see
# sbx-wait, which draws that wait.
#
# Optional per-project settings live in a `.sbx.json` at the project root:
#
#   {
#     "agent": "my-claude",
#     "kits": ["agent-skills"],
#     "memory": "8g",
#     "clone": true
#   }
#
# For a list of available "agents", see sbx/kits/sandboxes.
# For a list of available "kits", see sbx/kits/mixins.

set -euo pipefail

dotfiles="${SBX_UP_DOTFILES:-$HOME/src/personal/dotfiles}"
root="$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")"
config="$root/.sbx.json"

for dep in sbx jq; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    printf 'sbx-up: %s is not installed\n' "$dep" >&2
    exit 1
  fi
done

# The shell window runs sbx-wait through tmux, which does not necessarily
# inherit this shell's PATH, so the path has to be absolute. A sibling comes
# first, so running this script straight out of the repo uses the repo's copy.
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
if [[ -x "$self_dir/sbx-wait" ]]; then
  wait_bin="$self_dir/sbx-wait"
else
  wait_bin="$(command -v sbx-wait 2>/dev/null || true)"
fi
if [[ -z "$wait_bin" ]]; then
  printf 'sbx-up: sbx-wait is not installed; run ./sync-env\n' >&2
  exit 1
fi

slug() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9-' '-'
}

# The default branch gets an unsuffixed name; every other branch is suffixed.
branch="$(git branch --show-current 2>/dev/null || true)"
default="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
suffix=""
if [[ -n "$branch" && "$branch" != "${default#origin/}" ]]; then
  suffix="-$branch"
fi

name="$(slug "$(basename "$root")$suffix")"
window="$(slug "sbx$suffix")"
shell_window="$(slug "shell$suffix")"

config_json="$([[ -f "$config" ]] && cat "$config" || echo '{}')"
defaults='{"agent": "my-claude", "kits": ["agent-skills", "dotfiles"], "memory": "4g", "clone": false}'

# jq applies the defaults and builds the `sbx` arguments in one pass.
if ! args="$(jq -r --arg dotfiles "$dotfiles" --arg name "$name" \
  --argjson defaults "$defaults" '
  def kit($kind):
    if test("/") then . else "\($dotfiles)/sbx/kits/\($kind)/\(.)" end;

  ($defaults * .)
  | ["run", (.agent | kit("sandboxes")), "--name", $name, "--memory", .memory]
    + (if .clone then ["--clone"] else [] end)
    + (.kits | map("--kit", kit("mixins")))
  | .[]
' <<<"$config_json")"; then
  printf 'sbx-up: could not read %s\n' "$config" >&2
  exit 1
fi

# The dotfiles kit configures the sandbox after it starts, so the shell window
# waits for it rather than opening on a half-configured sandbox.
uses_dotfiles="$(jq -r --argjson defaults "$defaults" \
  '($defaults * .) | .kits | any(test("(^|/)dotfiles$"))' \
  <<<"$config_json" 2>/dev/null || echo false)"

run=(sbx)
while IFS= read -r arg; do
  run+=("$arg")
done <<<"$args"

# --force skips the confirmation prompt and removes a sandbox that is in use;
# closing stdin keeps any future prompt from hanging the script. A missing
# sandbox is the common case and not worth reporting; anything else is.
if ! removal="$(sbx rm --force "$name" </dev/null 2>&1)"; then
  if ! grep -qiE 'not found|no such|does not exist|unknown' <<<"$removal"; then
    printf 'sbx-up: could not remove the existing %s sandbox, continuing anyway:\n%s\n' \
      "$name" "$removal" >&2
  fi
fi

# Run the sandbox through the shell so a failure leaves the error on screen
# instead of closing the window with it.
launch="$(printf '%q ' "${run[@]}")"
launch+='|| { status=$?; printf "\nsbx-up: sbx exited with status %s\n" "$status"; '
launch+='printf "Press enter to close this window... "; read -r _; }'

if [[ -z "${TMUX:-}" ]]; then
  exec "${run[@]}"
fi

# Windows left over from the previous sandbox are now attached to nothing.
# Only an exact name match is killed, and never the window we were called
# from: tmux resolves a target it cannot match as a window against sessions
# and clients too, so a bare `kill-window -t "$window"` can take out an
# unrelated window.
current="$(tmux display-message -p '#{window_id}' 2>/dev/null || true)"
while read -r id existing; do
  if [[ ("$existing" == "$window" || "$existing" == "$shell_window") && "$id" != "$current" ]]; then
    tmux kill-window -t "$id" || true
  fi
done < <(tmux list-windows -F '#{window_id} #{window_name}' 2>/dev/null || true)

tmux new-window -n "$window" "$launch"

# `sbx run` above is still creating the container, and the dotfiles kit then
# clones and installs into it, so the shell window waits before it opens a
# shell. sbx-wait draws the progress and names the step it is waiting on.
wait_cmd=("$wait_bin")
if [[ "$uses_dotfiles" == "true" ]]; then
  wait_cmd+=(--dotfiles)
fi
wait_cmd+=("$name")

# Only exit 1 is fatal (the sandbox never answered). Exit 2 means the dotfiles
# kit failed or timed out: sbx-wait has already printed the end of its log, and
# a shell on an unconfigured sandbox is still more useful than no shell.
shell_launch="$(printf '%q ' "${wait_cmd[@]}")"
shell_launch+='
if [ "$?" = 1 ]; then
  printf "Press enter to close this window... "
  read -r _
  exit 1
fi
'

# -it gives the sandbox process a pseudo-terminal. Without it bash starts
# non-interactive (no prompt, no starship) and a full-screen program such as
# nvim has no terminal to draw on and exits at once.
#
# A login shell, so ~/.bash_profile runs and the prompt and PATH match my
# other machines.
# TODO: skip the shell window for non-clone sandboxes
shell_launch+="exec $(printf '%q ' sbx exec -it "$name" -- bash -l)"

exec tmux new-window -n "$shell_window" "$shell_launch"
