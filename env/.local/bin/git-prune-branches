#!/usr/bin/env bash
#
# Usage: git prune-branches [-n|--dry-run] [-y|--yes]
#
# Deletes local branches that are done:
#   - merged:  fully merged into the default branch.
#   - gone:    their upstream was deleted on the remote, which is what happens
#              after a PR merges. A squash or rebase merge leaves the local
#              commits unmerged, so these are force-deleted.
#
# Fetches with --prune first, so "gone" is current. Never touches the default
# branch, the current branch, or a branch checked out in another worktree.
# Lists the branches and asks before it deletes them, unless you pass --yes.

set -euo pipefail

dry_run=false
yes=false
for arg in "$@"; do
  case "$arg" in
    -n | --dry-run) dry_run=true ;;
    -y | --yes) yes=true ;;
    *)
      printf 'git-prune-branches: unknown argument: %s\n' "$arg" >&2
      exit 1
      ;;
  esac
done

git rev-parse --git-dir >/dev/null 2>&1 || {
  printf 'git-prune-branches: not inside a git repository\n' >&2
  exit 1
}

if git remote get-url origin >/dev/null 2>&1; then
  git fetch --prune --quiet origin
fi

default_ref="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
if [[ -z "$default_ref" ]]; then
  for candidate in main master; do
    if git rev-parse --verify --quiet "refs/heads/$candidate" >/dev/null; then
      default_ref="$candidate"
      break
    fi
  done
fi
if [[ -z "$default_ref" ]]; then
  printf 'git-prune-branches: cannot find the default branch; run: git remote set-head origin --auto\n' >&2
  exit 1
fi
default_branch="${default_ref#origin/}"

# Branches that we must keep, one per line.
keep="$(
  printf '%s\n' "$default_branch"
  git branch --show-current
  git worktree list --porcelain | sed -n 's|^branch refs/heads/||p'
)"

is_kept() {
  printf '%s\n' "$keep" | grep -qxF -- "$1"
}

merged=()
while IFS= read -r branch; do
  is_kept "$branch" || merged+=("$branch")
done < <(git for-each-ref --merged "$default_ref" --format='%(refname:short)' refs/heads)

gone=()
while IFS=' ' read -r branch track; do
  [[ "$track" == "[gone]" ]] || continue
  is_kept "$branch" && continue
  # A branch that is gone and also merged is in the merged list already.
  git merge-base --is-ancestor "refs/heads/$branch" "$default_ref" && continue
  gone+=("$branch")
done < <(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads)

if ((${#merged[@]} + ${#gone[@]} == 0)); then
  echo "git-prune-branches: nothing to prune."
  exit 0
fi

echo "Branches to delete (default branch: $default_ref):"
for branch in ${merged[@]+"${merged[@]}"}; do
  printf '  %-8s %s\n' merged "$branch"
done
for branch in ${gone[@]+"${gone[@]}"}; do
  printf '  %-8s %s\n' gone "$branch"
done

if $dry_run; then
  exit 0
fi

if ! $yes; then
  printf 'Delete these branches? [y/N] '
  read -r answer
  [[ "$answer" == [yY]* ]] || exit 1
fi

# -D for all: we already checked "merged" against the default branch, and -d
# would check against HEAD or the upstream instead.
git branch -D -- ${merged[@]+"${merged[@]}"} ${gone[@]+"${gone[@]}"}
