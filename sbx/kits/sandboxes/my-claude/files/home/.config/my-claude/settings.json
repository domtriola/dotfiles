{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.local/bin/statusline.sh"
  },
  "tui": "fullscreen",
  "remoteControlAtStartup": false,
  "permissions": {
    "deny": [
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git branch --move *)"
    ]
  }
}
