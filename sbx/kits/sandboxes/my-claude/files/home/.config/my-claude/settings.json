{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.local/bin/statusline.sh"
  },
  "tui": "fullscreen",
  "remoteControlAtStartup": false,
  "permissions": {
    "deny": [
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git branch --move *)"
    ]
  }
}
