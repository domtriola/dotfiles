# syntax=docker/sandbox-kit:3
#
# Generated by sync-skills from sbx/kits/mixins/agent-skills/descriptor.yaml.tmpl.
# Edit the template, not this file. sync-skills adds one agent-skill entry for
# each skill below the template.
schemaVersion: "3"
kind: mixin
displayName: Agent Skills
description: >-
  My personal agent skills, put into the skills directory of whichever agent
  runs in the sandbox.
sourceUrl: https://github.com/domtriola/dotfiles

# agent-skills.dockerfile copies the skills to /usr/share/agent-skills/<name>.
# The runtime then shows each skill at every skills directory that the agent
# kit declares with agent-skills@1, before the agent starts: ~/.claude/skills
# for Claude Code, and ~/.agents/skills for pi. No hook copies anything.
#
# Each entry is optional. The runtime does not overwrite a skill that is
# already there, for example from the host's shared skills store, so it skips
# a skill of the same name rather than refusing the sandbox.
capabilities:
  - type: com.docker.sandbox/agent-context@1
    config:
      contentFile: ./agent-skills-context.md
