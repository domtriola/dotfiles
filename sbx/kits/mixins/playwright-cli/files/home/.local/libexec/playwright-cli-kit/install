#!/bin/sh
#
# Usage: PLAYWRIGHT_CLI_VERSION=<version> sh install <workspace>
#
# Installs Node, playwright-cli, and Chromium with its system packages, for the
# playwright-cli kit. The kit's startup hook runs this in the background, with
# its output in ~/.playwright-cli-kit.log. It reads the workspace only to find
# the Node version the project asks for, and writes nothing there.
#
# PLAYWRIGHT_CLI_VERSION is the @playwright/cli version, which the kit's
# spec.yaml pins. PLAYWRIGHT_CLI_KIT_NODE_MIRROR names a different Node release
# mirror, for the tests. PLAYWRIGHT_CLI_KIT_LOCK_WAIT is how many seconds to
# wait for another apt-get to finish (600 by default).

set -eu

workspace="${1:-$PWD}"
cli_version="${PLAYWRIGHT_CLI_VERSION:-}"
mirror="${PLAYWRIGHT_CLI_KIT_NODE_MIRROR:-https://nodejs.org/dist}"
status_file="$HOME/.playwright-cli-kit.status"
kit_dir="$HOME/.local/share/playwright-cli-kit"
node_dir="$kit_dir/node"
wrapper="$HOME/.local/bin/playwright-cli"
tmp="$(mktemp -d)"

finish() {
  code=$?
  rm -rf "$tmp"
  if [ "$code" = 0 ]; then
    echo ready >"$status_file"
  else
    echo failed >"$status_file"
    echo "playwright-cli kit failed (exit $code)"
  fi
}
trap finish EXIT

# step names the current stage, in the status file and in the log.
step() {
  printf '%s\n' "$1" >"$status_file"
  echo "--- $1 ---"
}

fail() {
  echo "playwright-cli kit: $*" >&2
  exit 1
}

step "starting the playwright-cli kit"
date -u +%Y-%m-%dT%H:%M:%SZ
echo "workspace=$workspace"
[ -n "$cli_version" ] || fail "PLAYWRIGHT_CLI_VERSION is not set"

case "$(uname -m)" in
x86_64) arch=x64 ;;
aarch64 | arm64) arch=arm64 ;;
*) fail "no Node build for the architecture $(uname -m)" ;;
esac

# engines_node prints engines.node from a package.json, without a JSON parser,
# which the image does not promise. It reads the first "node" key after
# "engines", within its braces.
engines_node() {
  awk '
    /"engines"[[:space:]]*:/ { inside = 1 }
    inside && /"node"[[:space:]]*:/ {
      sub(/.*"node"[[:space:]]*:[[:space:]]*"/, "")
      sub(/".*/, "")
      print
      exit
    }
    inside && /}/ { inside = 0 }
  ' "$1"
}

# wanted_node prints what the project asks for, in the order nvm and the other
# version managers read it. An empty answer means the newest LTS.
wanted_node() {
  for file in .nvmrc .node-version; do
    if [ -f "$workspace/$file" ]; then
      echo "from $file" >&2
      head -n 1 "$workspace/$file"
      return
    fi
  done
  if [ -f "$workspace/package.json" ]; then
    echo "from engines in package.json" >&2
    engines_node "$workspace/package.json"
  fi
}

# resolve_node prints the release in index.tab that a version spec names. The
# index lists the releases newest first. Its tenth column is the LTS codename,
# or "-" for a release that is not LTS.
#
#   (empty), lts, lts/*            the newest LTS
#   lts/<codename>                 the newest release of that LTS line
#   node, latest, current, stable  the newest release
#   1.2.3, v1.2.3                  that release
#   >=N, >N                        the newest LTS, if its major is N or more
#   N, vN, N.x, ^N.1, ~N.1.2       the newest release of major N
#   >=N <M                         the newest release of major N
#
# A range with "||" uses its last alternative. Other ranges are read by their
# first major. This is not full semver, but it is sufficient to run a browser.
resolve_node() {
  spec="$(printf '%s' "$1" | tr 'A-Z' 'a-z' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  case "$spec" in
  *"||"*) spec="$(printf '%s' "${spec##*||}" | sed 's/^[[:space:]]*//')" ;;
  esac
  case "$spec" in
  "" | lts | "lts/*") rule=lts arg="" ;;
  lts/*) rule=codename arg="${spec#lts/}" ;;
  node | latest | current | stable) rule=newest arg="" ;;
  ">"*"<"*) rule=major arg="$(printf '%s' "$spec" | sed 's/^[>=v[:space:]]*//; s/[^0-9].*//')" ;;
  ">"*) rule=lts-from arg="$(printf '%s' "$spec" | sed 's/^[>=v[:space:]]*//; s/[^0-9].*//')" ;;
  *)
    if printf '%s' "$spec" | grep -Eq '^=?v?[0-9]+\.[0-9]+\.[0-9]+$'; then
      rule=exact arg="v$(printf '%s' "$spec" | sed 's/^=*v*//')"
    else
      rule=major arg="$(printf '%s' "$spec" | sed 's/^[=^~v[:space:]]*//; s/[^0-9].*//')"
    fi
    ;;
  esac
  awk -F '\t' -v rule="$rule" -v arg="$arg" '
    NR == 1 { next }
    {
      split(substr($1, 2), part, ".")
      major = part[1] + 0
      lts = tolower($10)
      if ((rule == "lts" && lts != "-") ||
          (rule == "codename" && lts == arg) ||
          (rule == "newest") ||
          (rule == "exact" && $1 == arg) ||
          (rule == "major" && arg != "" && major == arg + 0) ||
          (rule == "lts-from" && lts != "-" && major >= arg + 0)) {
        print $1
        exit
      }
    }
  ' "$tmp/index.tab"
}

step "choosing the Node version"
curl -fsSL "$mirror/index.tab" -o "$tmp/index.tab"
wanted="$(wanted_node)"
version="$(resolve_node "$wanted")"
[ -n "$version" ] || fail "no Node release matches \"$wanted\""
echo "node=$version (asked for \"$wanted\")"

step "downloading Node $version"
name="node-$version-linux-$arch"
curl -fsSL "$mirror/$version/$name.tar.gz" -o "$tmp/$name.tar.gz"
curl -fsSL "$mirror/$version/SHASUMS256.txt" -o "$tmp/SHASUMS256.txt"
(cd "$tmp" && grep "  $name.tar.gz\$" SHASUMS256.txt | sha256sum -c -) ||
  fail "the checksum of $name.tar.gz does not match"

# A new copy replaces all of the old one, so a restart that resolves another
# version leaves nothing of the previous one behind.
tar -xzf "$tmp/$name.tar.gz" -C "$tmp"
mkdir -p "$kit_dir"
rm -rf "$node_dir"
mv "$tmp/$name" "$node_dir"

PATH="$node_dir/bin:$PATH"
PLAYWRIGHT_MCP_BROWSER=chromium
export PATH PLAYWRIGHT_MCP_BROWSER

step "installing playwright-cli $cli_version"
# From $HOME, so that an .npmrc in the workspace does not apply. The package and
# its two dependencies have no install scripts, so none are allowed to run.
cd "$HOME"
npm install -g --ignore-scripts --prefix "$node_dir" "@playwright/cli@$cli_version"

step "installing Chromium"
# --with-deps installs the system packages with sudo and apt. --no-shell skips
# the headless shell, which playwright-cli does not use.
#
# Another apt-get often runs while a sandbox starts (the dotfiles kit's, for
# one), and it can break this install in two ways:
#
# - The loser of the race for the dpkg lock gets "Could not get lock".
# - The image's /etc/apt/apt.conf.d/docker-clean deletes the downloaded .deb
#   files after each `apt-get update`, which does not take the archives lock.
#   An update that runs between the download and dpkg gets "Could not open
#   file /var/cache/apt/archives/...".
#
# Playwright runs apt-get itself, so DPkg::Lock::Timeout cannot reach it.
# Instead, the install runs again once a second after either error, for up to
# lock_wait seconds. A new run downloads the files again. Any other failure
# stops at once, because a retry will not fix it.
lock_wait="${PLAYWRIGHT_CLI_KIT_LOCK_WAIT:-600}"
deadline=$(($(date +%s) + lock_wait))
until playwright-cli install-browser chromium --with-deps --no-shell >"$tmp/install.out" 2>&1; do
  cat "$tmp/install.out"
  grep -Eq 'Could not get lock|Could not open file /var/cache/apt/archives/' "$tmp/install.out" ||
    fail "the Chromium install failed"
  [ "$(date +%s)" -lt "$deadline" ] ||
    fail "another apt-get still got in the way after ${lock_wait}s"
  echo "--- another apt-get got in the way, so the Chromium install runs again ---"
  sleep 1
done
cat "$tmp/install.out"

# The wrapper comes last, so playwright-cli is on PATH only once it works. It
# puts the kit's Node first on PATH for the CLI alone, and makes Chromium the
# default browser: the CLI's own default is Chrome, which has no arm64 build.
mkdir -p "$(dirname "$wrapper")"
cat >"$wrapper" <<EOF
#!/bin/sh
# Written by the playwright-cli kit. See ~/.local/libexec/playwright-cli-kit.
PATH="$node_dir/bin:\$PATH"
PLAYWRIGHT_MCP_BROWSER="\${PLAYWRIGHT_MCP_BROWSER:-chromium}"
export PATH PLAYWRIGHT_MCP_BROWSER
exec "$node_dir/bin/playwright-cli" "\$@"
EOF
chmod +x "$wrapper"

echo "--- playwright-cli kit finished ---"
